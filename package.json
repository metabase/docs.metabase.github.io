{
  "name": "www.metabase.com",
  "version": "1.0.0",
  "description": "Website for Metabase.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/metabase/metabase.github.io"
  },
  "author": "GitHub",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "bugs": {
    "url": "https://github.com/metabase/metabase/issues"
  },
  "scripts": {
    "build": "astro build",
    "check": "bun lint-scripts && bun fmt:check && bun ts",
    "dev": "astro dev",
    "preview": "astro preview",
    "fmt": "prettier --write \"src/**/*.{ts,astro}\"",
    "fmt:check": "prettier --check \"src/**/*.{ts,astro}\"",
    "ts": "astro check",
    "test-vercel": "bun test tools/vercel",
    "test": "astro sync && vitest run",
    "lint-scripts": "eslint .",
    "lint-scripts-fix": "eslint . --fix",
    "lint-styles": "stylelint '**/*.css' --quiet",
    "lint-styles-fix": "stylelint '**/*.css' --fix",
    "lint-markdown": "npx markdownlint '**/*.{md,markdown}' --ignore-path=.markdownlintignore",
    "lint-markdown-fix": "npx markdownlint '**/*.{md,markdown}' --ignore-path=.markdownlintignore --fix",
    "lint-fix": "lint-scripts-fix && lint-styles-fix && lint-markdown-fix"
  },
  "homepage": "https://metabase.com",
  "dependencies": {
    "@inkeep/cxkit-js": "0.5.117",
    "glob": "^5.0.10",
    "gray-matter": "^4.0.3",
    "request": "^2.55.0",
    "titlecase": "^1.0.2",
    "yamljs": "^0.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inkeep/cxkit-types": "0.5.117",
    "@types/glob": "^5.0.10",
    "@types/yamljs": "^0.2.34",
    "@vercel/config": "^0.7.0",
    "@vercel/sdk": "^1.28.30",
    "astro": "^7.0.9",
    "bun-types": "^1.3.14",
    "eslint": "^8.29.0",
    "happy-dom": "^20.10.6",
    "liquidjs": "^10.27.2",
    "markdownlint-cli": "^0.33.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^1.0.0",
    "stylelint": "^14.9.0",
    "stylelint-config-standard-scss": "^4.0.0",
    "stylelint-order": "^5.0.0",
    "typescript": "^6.0.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
