{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "_docs",
    "_site",
    "public/docs/gdpr-cookie-notice",
    "public/docs/js"
  ],
  "compilerOptions": {
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
