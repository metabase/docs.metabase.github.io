---
import Footer from "@/components/chrome/Footer.astro";
import Header from "@/components/chrome/Header.astro";
import LiquidInclude from "@/components/LiquidInclude.astro";
import { getLiquidRenderer } from "@/lib/liquid/liquidRenderer";

type Props = {
  page: Record<string, unknown>;
  dirname: string;
  unify?: boolean;
  /** Enables the light/dark theme (init script + docs-theme.css). */
  docsTheme?: boolean;
};

const { page, dirname, unify, docsTheme } = Astro.props;

const lq = getLiquidRenderer({ page, dirname });
---

<!doctype html>
<html prefix="og: https://ogp.me/ns#" lang="en-US">
  <LiquidInclude lq={lq} src="head.html" {unify} docs_theme={docsTheme} />

  <body>
    <slot name="header">
      <Header />
    </slot>

    <div>
      <slot />
    </div>

    <Footer />
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/contentloaded.min.js"
    ></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/lightbox.js"
    ></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/documentation.js"
    ></script>
    <script is:inline type="text/javascript" src="/docs/js/blog.js"></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/syntax-highlight.js"
    ></script>
    {Astro.url.pathname.includes("/docs/") &&
      Astro.url.pathname.includes("embedding") && (
        <script
          is:inline
          type="text/javascript"
          src="/docs/js/docs/checkpoints.js"
        ></script>
      )}
  </body>
</html>
