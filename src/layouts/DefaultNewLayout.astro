---
import { getLiquidRenderer } from "@/lib/liquid";
import LiquidInclude from "@/components/LiquidInclude.astro";

type Props = {
  page: Record<string, unknown>;
};

const { page } = Astro.props;

const lq = getLiquidRenderer({ page });
---

<!doctype html>
<html prefix="og: https://ogp.me/ns#" lang="en-US">
  <LiquidInclude lq={lq} src="head.html" />

  <body>
    <LiquidInclude lq={lq} src="shared-chrome/header.html" />

    <div>
      <slot />
    </div>

    <LiquidInclude lq={lq} src="shared-chrome/footer.html" />
    <script type="text/javascript" src="/js/contentloaded.min.js"></script>
    <script type="text/javascript" src="/js/lightbox.js"></script>
    <script type="text/javascript" src="/js/documentation.js"></script>
    <script type="text/javascript" src="/js/blog.js"></script>
    <script type="text/javascript" src="/js/syntax-highlight.js"></script>

    {
      Astro.url.pathname.includes("/docs/") &&
        Astro.url.pathname.includes("embedding") && (
          <script type="text/javascript" src="/js/docs/checkpoints.js" />
        )
    }
  </body>
</html>
