---
import chrome from '../../_data/shared_chrome.json'
import Head from '../layouts/utils/head.astro';

interface Props {
  page?: Record<string, any>;
}
const { page } = Astro.props;
---
<!DOCTYPE html>
<html prefix="og: https://ogp.me/ns#" lang="en-US">

  <Head page={page} />

  <body>
    <div class="legacy-scope" set:html={chrome.header_html} />

    <div>
      <slot />
    </div>

    <div class="legacy-scope" set:html={chrome.footer_html} />
    <script type="text/javascript" src="/js/contentloaded.min.js"></script>
    <script type="text/javascript" src="/js/lightbox.js"></script>
    <script type="text/javascript" src="/js/documentation.js"></script>
    <script type="text/javascript" src="/js/blog.js"></script>
    <script type="text/javascript" src="/js/syntax-highlight.js"></script>
  
    <!-- {% if page.url contains '/docs/' and page.url contains 'embedding' %}
      <script type="text/javascript" src="/js/docs/checkpoints.js"></script>
    {% endif %} -->
  </body>
</html>
