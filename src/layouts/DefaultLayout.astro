---
import StaticFooter from "@/components/chrome/StaticFooter.astro";
import StaticHeader from "@/components/chrome/StaticHeader.astro";
import LiquidInclude from "@/components/LiquidInclude.astro";
import { getLiquidRenderer } from "@/lib/liquid/liquidRenderer";

type Props = {
  page: {
    version?: string;
  };
  dirname: string;
};

const { page, dirname } = Astro.props;

const lq = getLiquidRenderer({ page, dirname });
---

<!doctype html>
<html lang="en-US">
  <LiquidInclude lq={lq} src="head.html" />

  <body>
    <StaticHeader />

    <div class="MB-Documentation MB-Page ZoomImages">
      <slot />
    </div>
    <StaticFooter />

    <script
      is:inline
      type="text/javascript"
      src="/docs/js/contentloaded.min.js"
    ></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/lightbox.js"
    ></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/documentation.js"
    ></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/anchor.min.js"
    ></script>
    <script
      is:inline
      type="text/javascript"
      src="/docs/js/anchor-links.js"
    ></script>
  </body>
</html>
