---
import LiquidInclude from "@/components/LiquidInclude.astro";
import { UNIFY_ENABLED_PAGES } from "@/constants";
import { getLiquidRenderer } from "@/lib/liquid/liquidRenderer";
import DefaultNewLayout from "./DefaultNewLayout.astro";

type Props = {
  page: {
    title: string;
    url: string;
    category?: string;
  };
  dirname: string;
};

const { page, dirname } = Astro.props;

const parts = Astro.url.pathname.split("/");
const isHomePage = parts[3] === "index" || !parts[3];
const showBreadcrumb = !isHomePage || parts[2] === "all";

const lq = getLiquidRenderer({ page, dirname });

const unify = UNIFY_ENABLED_PAGES.includes(page.url);
---

<DefaultNewLayout page={page} dirname={dirname} {unify}>
  <div class="bootstrap">
    <div class="learn docs blog-post MB-Page">
      <LiquidInclude lq={lq} src="docs/left-sidebar.html" domain="docs" />

      <article class="learn__post learn__article">
        <LiquidInclude
          lq={lq}
          src="learn/top-bar.html"
          domain="docs"
          show_breadcrumb={showBreadcrumb}
        />

        <div class="learn__post__content">
          {!showBreadcrumb && <LiquidInclude lq={lq} src="docs_version.html" />}

          <LiquidInclude lq={lq} src="docs/blockquotes.html" />

          <slot />

          <div>
            <div class="widget-separator"></div>
            {
              page.category !== "Cloud" && (
                <p>
                  Read docs for other{" "}
                  <a href="/docs/all">versions of Metabase</a>.
                </p>
              )
            }
          </div>
        </div>

        <div class="learn__right-sidebar">
          <div id="sub-navigation-content">
            {/* Is populated via js */}
          </div>
          <LiquidInclude
            lq={lq}
            src="shared/was-this-helpful-widget.html"
            should_add_propose_a_change_dialog="true"
          />
        </div>
      </article>
    </div>
  </div>

  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-version-selector.js"></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-anchor-links.js"></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-code-snippet-copy.js"></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-table-overflow.js"></script>
  <script is:inline type="text/javascript" src="/docs/js/image-zoom.js"
  ></script>
  <script is:inline type="text/javascript" src="/docs/js/learn/left-sidebar.js"
  ></script>
  <script is:inline type="text/javascript" src="/docs/js/docs/right-sidebar.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/position-feedback-widget.js"></script>

  <script is:inline src="/docs/js/use-custom-header-checkout-link.js"></script>
</DefaultNewLayout>
