---
import Breadcrumb from "@/components/chrome/Breadcrumb.astro";
import DocActions from "@/components/chrome/DocActions.astro";
import DocsHeader from "@/components/chrome/DocsHeader.astro";
import LeftSidebar from "@/components/chrome/LeftSidebar.astro";
import PageNav from "@/components/chrome/PageNav.astro";
import PrevNext from "@/components/chrome/PrevNext.astro";
import SectionBar from "@/components/chrome/SectionBar.astro";
import VersionNotice from "@/components/chrome/VersionNotice.astro";
import LiquidInclude from "@/components/LiquidInclude.astro";
import { UNIFY_ENABLED_PAGES } from "@/constants";
import { getDocBreadcrumbs, type Crumb } from "@/lib/docs/breadcrumbs";
import { getDocUrls } from "@/lib/docs/docUrls";
import { buildDocJsonLd } from "@/lib/docs/jsonLd";
import {
  getActiveCategory,
  getNavForVersion,
  getSections,
} from "@/lib/docs/nav";
import { parseDocUrl } from "@/lib/docs/resolveDoc";
import { splitAtTitle } from "@/lib/docs/splitAtTitle";
import { getLiquidRenderer } from "@/lib/liquid/liquidRenderer";
import DefaultNewLayout from "./DefaultNewLayout.astro";

// The `.bootstrap .learn …` classes keep the vendored bundle's article
// styles and the hooks its scripts need (public/docs/js); the utilities here
// override them through the cascade layers in src/styles/docs.css.
type Props = {
  page: {
    title: string;
    url: string;
    category?: string;
    version?: string;
    latest?: boolean;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
    meta_description?: string;
  };
  dirname: string;
  /** The page's Markdown version, for docs that publish one. */
  markdownUrl?: string;
  /** The page's front matter summary, as inline HTML. */
  summary?: string;
};

const { page, dirname, markdownUrl, summary } = Astro.props;

// The path after the version: "" on the docs home, undefined outside a
// version (/docs/all). Only doc pages get structured data, the AI tools row,
// prev/next and the feedback widget; the docs home also has no breadcrumbs.
const docPath = parseDocUrl(page.url)?.path;
const isDocsHome = docPath === "";
const isDocPage = !!docPath;

const lq = getLiquidRenderer({ page, dirname });

const unify = UNIFY_ENABLED_PAGES.includes(page.url);

const version = page.latest ? "latest" : (page.version ?? "latest");

// The page's category drives the header tabs, the sidebar and prev/next. The
// docs home and /docs/all have none; their sidebar shows the first category.
const nav = getNavForVersion(version);
const category = getActiveCategory(nav, page.url);
const sections = getSections(nav, category);

// The breadcrumb trail (Breadcrumb.astro) and its structured data. Pages
// outside the docs tree (/docs/all) get just their title.
const breadcrumbs: Crumb[] = page.has_magic_breadcrumbs
  ? getDocBreadcrumbs(page, nav)
  : [{ name: page.title }];

// For agents and search engines (head.html): the page's Markdown version,
// and on doc pages, structured data about the page and its breadcrumb trail.
const headPage = markdownUrl
  ? { ...page, markdown_alternate: new URL(markdownUrl, Astro.site).href }
  : page;
const jsonLd =
  page.has_magic_breadcrumbs && isDocPage
    ? buildDocJsonLd({
        site: Astro.site!,
        page,
        breadcrumbs,
        docUrls: await getDocUrls(),
      })
    : undefined;

// The summary and the AI tools row go between the Markdown's h1 and the body,
// so the slot is rendered to a string and split there.
const split =
  (markdownUrl || summary) && isDocPage
    ? splitAtTitle(await Astro.slots.render("default"))
    : undefined;
---

<DefaultNewLayout page={headPage} dirname={dirname} {unify} {jsonLd}>
  <DocsHeader slot="header" version={version} {sections} sidebar />
  <SectionBar />

  <div class="bootstrap">
    {/* Below lg the vendored grid collapses and paints the page to the
        right of its centered box with a 1000px shadow. From lg up, pin the
        nav to the viewport edge and center the article in the rest. */}
    <div class="learn docs blog-post MB-Page tw:print:grid-cols-1 tw:max-lg:grid-cols-1 tw:max-lg:border-b-surface-hover tw:max-lg:shadow-[1000px_0_0_var(--tw-color-page)] tw:lg:max-w-none tw:lg:grid-cols-[var(--tw-spacing-sidebar)_1fr] tw:lg:bg-page tw:lg:shadow-none">
      <LeftSidebar
        url={page.url}
        version={version}
        category={category ?? nav.categories[0]}
        {sections}
      />
      {/* Click target behind the mobile nav drawer (SectionBar.astro's toggle
          opens it, LeftSidebar.astro's script); it fades the way the drawer
          slides. On desktop, where there is no drawer, it would take a grid
          cell. */}
      <div
        class="tw:invisible tw:fixed tw:inset-x-0 tw:top-[calc(var(--tw-spacing-header-offset)+var(--tw-spacing-section-bar))] tw:bottom-0 tw:z-998 tw:bg-backdrop tw:opacity-0 tw:motion-safe:transition-[opacity,visibility] tw:motion-safe:duration-250 tw:lg:hidden tw:nav-open:visible tw:nav-open:opacity-100 tw:print:hidden"
        data-docs-nav-close
      ></div>

      {/* The text column with a --spacing-gutter either side, plus the
          --spacing-toc column. The vendored bundle reserves 56px above the
          article for the absolutely positioned breadcrumb bar from lg up;
          the docs home renders none. Below lg it reserves the fixed section
          bar's height instead. */}
      <article
        class:list={[
          "learn__post learn__article tw:grid tw:grid-cols-[1fr_var(--tw-spacing-toc)] tw:bg-page tw:shadow-[1000px_0_0_var(--tw-color-page)] tw:max-lg:grid-cols-1 tw:lg:mx-auto tw:lg:max-w-[calc(var(--tw-spacing-article)+2*var(--tw-spacing-gutter)+var(--tw-spacing-toc))] tw:print:grid-cols-1",
          "tw:max-lg:pt-section-bar",
          { "tw:lg:pt-0": isDocsHome },
        ]}
      >
        {/* The breadcrumb bar from lg up, as wide as the text column, so its
            divider ends where the text does. position-feedback-widget.js
            measures `.top-bar`. */}
        {!isDocsHome && (
          <div class="top-bar tw:absolute tw:top-0 tw:left-gutter tw:z-3 tw:flex tw:h-[57px] tw:w-[calc(100%-2*var(--tw-spacing-gutter)-var(--tw-spacing-toc))] tw:items-center tw:border-b tw:border-border tw:py-2 tw:max-xl:w-[calc(100%-var(--tw-spacing-gutter)-var(--tw-spacing-gutter-narrow)-var(--tw-spacing-toc))] tw:max-lg:hidden tw:print:hidden">
            <Breadcrumb crumbs={breadcrumbs} variant="top-bar" />
          </div>
        )}

        {/* The grid column can be wider than the measure, so cap everything
            in it, including the script-generated table and h2 wrappers. */}
        <div class="learn__post__content docs-prose tw:lg:*:max-w-article">
          {!isDocsHome && <Breadcrumb crumbs={breadcrumbs} variant="inline" />}
          <VersionNotice version={page.version} pageUrl={page.url} />

          {split ? (
            <>
              <Fragment set:html={split[0]} />
              {/* The bottom margin collapses with DocActions' top margin. */}
              {summary && (
                <p
                  class="tw:mt-3 tw:mb-4 tw:text-xl tw:text-pretty tw:text-secondary"
                  set:html={summary}
                />
              )}
              {markdownUrl && (
                <DocActions markdownUrl={markdownUrl} version={version} />
              )}
              <Fragment set:html={split[1]} />
            </>
          ) : (
            <slot />
          )}

          {isDocPage && <PrevNext {category} pageUrl={page.url} />}

          <div class="tw:print:hidden">
            <div class="widget-separator"></div>
            {page.category !== "Cloud" && (
              <p>
                Read docs for other <a href="/docs/all">versions of Metabase</a>
                .
              </p>
            )}
          </div>
        </div>

        {/* The vendored sticky offset assumes the 77px marketing navbar; keep
            its 14px overlap under the docs header. Below lg the sidebar
            dissolves: its list hides (the section bar's dropdown takes over)
            and the feedback widget follows the article. */}
        <div class="learn__right-sidebar tw:max-lg:contents tw:lg:top-[calc(var(--tw-spacing-header)-14px)] tw:print:hidden">
          <PageNav />
          {isDocPage && (
            <LiquidInclude
              lq={lq}
              src="shared/was-this-helpful-widget.html"
              should_add_propose_a_change_dialog="true"
            />
          )}
        </div>
      </article>
    </div>
  </div>

  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-anchor-links.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-code-snippet-copy.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-table-overflow.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/image-zoom.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/position-feedback-widget.js"
  ></script>
</DefaultNewLayout>
