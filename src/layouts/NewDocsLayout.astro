---
import Breadcrumb from "@/components/chrome/Breadcrumb.astro";
import CopyMarkdownButton from "@/components/chrome/CopyMarkdownButton.astro";
import DocsHeader from "@/components/chrome/DocsHeader.astro";
import LeftSidebar from "@/components/chrome/LeftSidebar.astro";
import PageNav from "@/components/chrome/PageNav.astro";
import VersionNotice from "@/components/chrome/VersionNotice.astro";
import LiquidInclude from "@/components/LiquidInclude.astro";
import { UNIFY_ENABLED_PAGES } from "@/constants";
import { getLiquidRenderer } from "@/lib/liquid/liquidRenderer";
import DefaultNewLayout from "./DefaultNewLayout.astro";

// The `.bootstrap .learn …` classes keep the vendored bundle's article
// styles and the hooks its scripts need (public/docs/js); the utilities here
// override them through the cascade layers in src/styles/docs.css.
type Props = {
  page: {
    title: string;
    url: string;
    category?: string;
    version?: string;
    latest?: boolean;
  };
  dirname: string;
  /** The page's Markdown version, for docs that publish one. */
  markdownUrl?: string;
};

const { page, dirname, markdownUrl } = Astro.props;

const parts = Astro.url.pathname.split("/");
const isHomePage = parts[3] === "index" || !parts[3];
const showBreadcrumb = !isHomePage || parts[2] === "all";

const lq = getLiquidRenderer({ page, dirname });

const unify = UNIFY_ENABLED_PAGES.includes(page.url);

const version = page.latest ? "latest" : (page.version ?? "latest");
---

<DefaultNewLayout page={page} dirname={dirname} {unify}>
  <DocsHeader slot="header" version={version} pageUrl={page.url} sidebar />

  <div class="bootstrap">
    {/* Below lg the vendored grid collapses and paints the page to the
        right of its centered box with a 1000px shadow. With the sidebar
        visible, pin the nav to the viewport edge and center the article in
        the remaining space; the sidebar is wider than Learn's 226px because
        docs nav labels are longer. */}
    <div class="learn docs blog-post MB-Page tw:max-lg:grid-cols-1 tw:max-lg:border-b-surface-hover tw:max-lg:shadow-[1000px_0_0_var(--tw-color-page)] tw:lg:max-w-none tw:lg:grid-cols-[var(--tw-spacing-sidebar)_1fr] tw:lg:bg-page tw:lg:shadow-none">
      <LeftSidebar url={page.url} version={version} />
      {/* Click target behind the mobile nav drawer (DocsHeader.astro opens
          it); it fades the way the drawer slides (LeftSidebar.astro). On
          desktop, where there is no drawer, it would take a grid cell. */}
      <div
        class="tw:invisible tw:fixed tw:inset-x-0 tw:top-header tw:bottom-0 tw:z-999 tw:bg-backdrop tw:opacity-0 tw:motion-safe:transition-[opacity,visibility] tw:motion-safe:duration-250 tw:lg:hidden tw:nav-open:visible tw:nav-open:opacity-100"
        data-docs-nav-close
      ></div>

      {/* The text column with a --spacing-gutter either side, plus the
          --spacing-toc column. The vendored bundle reserves 56px above the
          article for the absolutely positioned breadcrumb bar; the docs home
          renders none. */}
      <article
        class:list={[
          "learn__post learn__article tw:grid tw:grid-cols-[1fr_var(--tw-spacing-toc)] tw:bg-page tw:shadow-[1000px_0_0_var(--tw-color-page)] tw:max-lg:grid-cols-1 tw:lg:mx-auto tw:lg:max-w-[calc(var(--tw-spacing-article)+2*var(--tw-spacing-gutter)+var(--tw-spacing-toc))]",
          { "tw:pt-0": !showBreadcrumb },
        ]}
      >
        {/* The vendored top bar is centered across the article and reserves
            140px on the right; pin it to the text column so its divider ends
            where the text does, and let the breadcrumb take whatever the
            Copy Markdown button leaves. The content padding-right drops to
            --spacing-gutter-narrow below 1200px. */}
        {showBreadcrumb && (
          <div class="top-bar tw:border-b-border tw:lg:left-gutter tw:lg:w-[calc(100%-2*var(--tw-spacing-gutter)-var(--tw-spacing-toc))] tw:lg:transform-none tw:lg:pl-0 tw:lg:max-xl:w-[calc(100%-var(--tw-spacing-gutter)-var(--tw-spacing-gutter-narrow)-var(--tw-spacing-toc))]">
            <div class="tw:min-w-0 tw:flex-1">
              <Breadcrumb page={page} />
            </div>
            {markdownUrl && <CopyMarkdownButton href={markdownUrl} />}
          </div>
        )}

        {/* The grid column can be wider than the measure, so cap everything
            in it, including the script-generated table and h2 wrappers. */}
        <div class="learn__post__content docs-prose tw:lg:*:max-w-article">
          <VersionNotice version={page.version} />

          <slot />

          <div>
            <div class="widget-separator"></div>
            {page.category !== "Cloud" && (
              <p>
                Read docs for other <a href="/docs/all">versions of Metabase</a>
                .
              </p>
            )}
          </div>
        </div>

        {/* The vendored sticky offset assumes the 77px marketing navbar; keep
            its 14px overlap under the docs header. Below lg the sidebar
            dissolves so the TOC becomes an in-flow row above the article. */}
        <div class="learn__right-sidebar tw:max-lg:contents tw:lg:top-[calc(var(--tw-spacing-header)-14px)] tw:max-lg:[&>:not(#toc-toggle):not(#sub-navigation-content)]:hidden">
          <PageNav />
          {!isHomePage && (
            <LiquidInclude
              lq={lq}
              src="shared/was-this-helpful-widget.html"
              should_add_propose_a_change_dialog="true"
            />
          )}
        </div>
      </article>
    </div>
  </div>

  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-anchor-links.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-code-snippet-copy.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/new-docs-table-overflow.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/image-zoom.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/learn/left-sidebar.js"
  ></script>
  <script
    is:inline
    type="text/javascript"
    src="/docs/js/position-feedback-widget.js"
  ></script>
  <script is:inline src="/docs/js/use-custom-header-checkout-link.js"></script>
</DefaultNewLayout>
