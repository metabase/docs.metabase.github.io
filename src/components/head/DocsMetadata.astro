---
// Converted from _includes/docs-metadata.html
import { site } from "../../lib/docs-liquid";

interface Props {
  page: Record<string, any>;
}
const { page } = Astro.props;

function truncatewords(text: string, count: number, truncateString = "..."): string {
  const words = text.split(/\s+/);
  return words.length <= count ? text : `${words.slice(0, count).join(" ")}${truncateString}`;
}

function stripHtml(text: string): string {
  return text.replace(/<[^>]*>/g, "");
}

const title = `${page.title} | Metabase Documentation`;
const description =
  page.description ?? page.summary ?? stripHtml(truncatewords(String(page.content ?? ""), 42));
const image = "/images/docs/docs-og.png";
const ogUrl = `${site.url}${String(page.url ?? "").replaceAll("/index.html", "")}`;
---

<title>{title}</title>
<meta name="twitter:site" content={`@${site.twitter_username}`} />
{page.author && <meta name="twitter:creator" content={page.author} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={`${site.url}${image}`} />

<meta
  property="og:site_name"
  content="Metabase | Business Intelligence, Dashboards, and Data Visualization"
/>
<meta property="og:type" content="article" />
<meta property="og:url" content={ogUrl} />
<meta name="title" property="og:title" content={title} />
<meta name="description" property="og:description" content={description} />
<meta name="image" property="og:image" content={`${site.url}${image}`} />
