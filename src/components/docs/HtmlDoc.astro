---
import type { DocPage } from "@/lib/docs/constructDocMetadata";
import { renderDocLiquid } from "@/lib/docs/renderDocLiquid";
import { rewriteDocLinks } from "@/lib/docs/rewriteDocLinks";
import type { DataEntryMap } from "astro:content";

// A `.html` doc (TypeDoc SDK API reference pages, api.html ToC pages): an
// already complete standalone HTML document. Only Liquid runs on it (e.g. the
// embedded-analytics-sdk-metadata include), with no markdown conversion and no
// docs layout chrome (mirrors the old Jekyll `docs-api` layout, which was a
// bare passthrough).

type Props = {
  doc: DataEntryMap["docsHtml"][number];
  page: DocPage;
  dirname: string;
};

const { doc, page, dirname } = Astro.props;

// Unlike markdown docs, these aren't parsed, so their links are rewritten as
// text. Notably, this pins their many `/latest/embedding/` URLs (in hrefs and
// inline scripts) to the doc's version.
const html = await renderDocLiquid({
  body: rewriteDocLinks(doc.body ?? "", {
    version: page.version,
    latest: !!page.latest,
  }),
  page,
  dirname,
});

// TypeDoc's standalone HTML is generated upstream with root-relative asset
// paths. In production, those paths resolve against the marketing site, so
// keep the generated sources untouched and scope their local assets here.
const scoped = html
  .replaceAll('"/gdpr-cookie-notice/', '"/docs/gdpr-cookie-notice/')
  .replaceAll('"/js/', '"/docs/js/')
  .replaceAll('"/css/', '"/docs/css/');
---

<Fragment set:html={scoped} />
