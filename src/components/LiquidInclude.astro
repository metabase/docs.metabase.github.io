---
import fs from "node:fs";
import path from "node:path";
import {
  getLiquidRenderer,
  type LiquidRenderer,
} from "@/lib/liquid/liquidRenderer";

const INCLUDES_ROOT = path.join(process.cwd(), "_includes");

// Astro equivalent of Jekyll's `{% include %}` tag. Extra props are passed
// through as `include.*` inside the partial, just like Jekyll:
//   {% include foo.html param="x" %}  ->  <LiquidInclude src="foo.html" param="x" />
// `.mdx` docs have no renderer to hand in, so one is created on demand; pass
// `page` (e.g. `page={props.page}`) if the partial reads `page.*` variables.
interface Props {
  lq?: LiquidRenderer;
  page?: Record<string, unknown>;
  src: string;
  [param: string]: unknown;
}

const { lq: lqProp, page = {}, src, ...params } = Astro.props;
const lq = lqProp ?? getLiquidRenderer({ page, dirname: INCLUDES_ROOT });

const html = await lq.render(
  fs.readFileSync(path.join(INCLUDES_ROOT, src), "utf-8"),
  { include: params },
);
---

<Fragment set:html={html} />
