---
import Chevron from "@/icons/chevron.svg";
import { baseCtx } from "@/lib/liquid/liquidRenderer";
import { renderVersionListItems } from "./utils/versionUtils";

type Props = {
  version?: string;
  latest?: boolean;
};

const { version, latest } = Astro.props;
const { site } = baseCtx;
---

<div class="version__selector cursor-pointer">
  <span class="version__current">
    {version}
    <Chevron />
  </span>
  <ul
    class="version__dropdown"
    data-component="versions-list"
    data-version={version ?? ""}
    set:html={renderVersionListItems(
      version,
      site.data.version_support,
      site.available_versions,
    )}
  />
</div>

{/*
`latest` is excluded since it gets rebuilt often enough to stay current on its own. This targets
older pages (e.g. v0.44) that rarely get rebuilt but should still show an up-to-date version list
in the selector.
*/}
{!latest && <script>
  import { fetchVersions, renderVersionListItems } from "./utils/versionUtils";

  const updateVersionsList = async (el: Element) => {
    const versions = await fetchVersions();
    const pageVersion = el.getAttribute("data-version");
    const { available_versions, version_support } = versions;
    el.innerHTML = renderVersionListItems(
      pageVersion,
      version_support,
      available_versions,
    );
  };

  document
    .querySelectorAll('[data-component="versions-list"]')
    .forEach(updateVersionsList);
</script>}
