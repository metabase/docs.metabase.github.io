---
import Chevron from "@/icons/chevron.svg";
import { baseCtx } from "@/lib/liquid/liquidRenderer";

type Props = {
  version?: string;
};

const { version } = Astro.props;
const { site } = baseCtx;

const currentVersion = version === "latest" ? site.docs_version : version;
const versions = [...site.available_versions].reverse().slice(0, 10);
---

<div class="version__selector cursor-pointer">
  <div class="version__current">
    <span>{currentVersion}</span>
    <Chevron />
  </div>
  <ul class="version__dropdown">
    {versions
      .filter((v: string) => v !== version)
      .map((v: string) => {
        const support = site.data.version_support[v];
        return (
          <li>
            <a href={`/docs/${v}/`}>
              <div class="version__dropdown--item">
                <span>{v}</span>
                {support?.status === "unsupported" ? (
                  <span class="version__tag version__tag--unsupported">
                    unsupported
                  </span>
                ) : support?.lts ? (
                  <span class="version__tag version__tag--lts">lts</span>
                ) : null}
              </div>
            </a>
          </li>
        );
      })}
    <li>
      <a href="/docs/all">See more</a>
    </li>
  </ul>
</div>

<script>
  function initDocsVersionSelector() {
    const versionSelectors = document.querySelectorAll(".version__selector");

    versionSelectors.forEach(function (versionSelector) {
      versionSelector.addEventListener("click", function (event) {
        event.stopPropagation(); // Prevent this click from triggering the outside click event
        versionSelector.classList.toggle("open");
      });
    });

    // Close selector on click outside with a slight delay
    document.addEventListener("click", function (event) {
      setTimeout(() => {
        versionSelectors.forEach(function (versionSelector) {
          if (!versionSelector.contains(event.target as Node)) {
            versionSelector.classList.remove("open");
          }
        });
      }, 10); // Small delay to ensure clicks inside elements get registered first
    });
  }

  window.addEventListener("DOMContentLoaded", () => {
    initDocsVersionSelector();
  });
</script>

<style is:global>
  .bootstrap .learn .version__selector {
    display: inline-block;
    height: auto;
    margin-top: 32px !important;
    position: relative;
    width: auto;
  }
  @media (min-width: 992.02px) {
    .bootstrap .learn .version__selector {
      margin-top: 0 !important;
    }
  }

  .bootstrap .learn .version__current {
    background-color: white;
    border: 1px solid rgba(198, 201, 210, 0.5);
    display: inline-flex;
    float: none;
    gap: 0 !important;
    padding: 10px 0 12px 12px;
    width: auto;

    &:hover {
      border-color: #c2daf0;
    }
  }
  .bootstrap .learn .version__selector.open .version__current {
    border-color: #c2daf0;
  }
  @media (min-width: 992.02px) {
    .bootstrap .learn .version__current {
      background-color: transparent;
      border: none;
    }
  }

  .bootstrap .learn .version__current svg {
    margin-top: 2px;
  }

  .bootstrap .learn .version__dropdown {
    margin-top: 0;
    left: 0;
    right: auto;
    top: 100%;
  }
  @media (min-width: 992.02px) {
    .bootstrap .learn .version__dropdown {
      left: auto;
      right: 0;
    }
  }

  .bootstrap .learn div.learn__post__content .version__selector {
    display: inline-block;
  }
  /* FIX: the top-bar picker is hidden only at ≤992px; show this one in that range only */
  @media (min-width: 992.02px) {
    .bootstrap .learn div.learn__post__content .version__selector {
      display: none;
    }
  }
</style>
