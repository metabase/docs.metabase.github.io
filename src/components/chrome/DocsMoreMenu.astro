---
import Check from "@/icons/check.svg";
import { iconButton, menuItem, menuPanel } from "./docs-ui";

// The header's ⋯ menu: outside links and the theme options. Opens and closes
// like the version selector (dropdown.ts).
const links = [
  { label: "Metabase.com", href: "/" },
  { label: "GitHub", href: "https://github.com/metabase/metabase" },
  { label: "Forum", href: "https://discourse.metabase.com/" },
  { label: "Contact support", href: "/help-premium" },
  { label: "What’s new", href: "/releases" },
];

// Values of data-theme-preference (_includes/docs/theme-init.js).
const themes = [
  { value: "system", label: "System" },
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
];

// font-normal: the vendored bundle bolds header links.
const item = [menuItem, "tw:font-normal tw:text-secondary tw:hover:text-brand"];
---

<div class="tw:relative" data-dropdown>
  <button
    type="button"
    class:list={[iconButton, "tw:peer"]}
    aria-label="More"
    aria-expanded="false"
    data-dropdown-trigger
  >
    <svg
      class="tw:size-5 tw:fill-current"
      viewBox="0 0 20 20"
      aria-hidden="true"
    >
      <circle cx="4.5" cy="10" r="1.5" />
      <circle cx="10" cy="10" r="1.5" />
      <circle cx="15.5" cy="10" r="1.5" />
    </svg>
  </button>
  <ul class:list={[menuPanel, "tw:right-0 tw:min-w-48"]}>
    {links.map(({ label, href }) => (
      <li class="tw:m-0">
        <a class:list={item} href={href}>
          {label}
        </a>
      </li>
    ))}
    {/* aria-pressed marks the current choice (set by the script below). The
        check repeats it, so the state does not depend on color alone. */}
    <li class="tw:m-0 tw:mt-1 tw:border-t tw:border-border tw:pt-1">
      <div role="group" aria-labelledby="docs-theme-heading">
        <span
          id="docs-theme-heading"
          class="tw:block tw:px-4 tw:pt-2 tw:pb-1 tw:text-xs tw:text-muted"
        >
          Theme
        </span>
        {themes.map(({ value, label }) => (
          <button
            type="button"
            class:list={[
              item,
              "tw:group tw:w-full tw:cursor-pointer tw:justify-between tw:border-0 tw:bg-transparent tw:text-left tw:font-sans tw:aria-pressed:text-brand",
            ]}
            aria-pressed="false"
            data-theme-option={value}
          >
            {label}
            <Check
              class="tw:hidden tw:size-4 tw:shrink-0 tw:group-aria-pressed:block"
              aria-hidden="true"
            />
          </button>
        ))}
      </div>
    </li>
  </ul>
</div>

<script>
  import "./dropdown";

  // _includes/docs/theme-init.js sets data-theme-preference before first
  // paint, and applies and stores a new one (setDocsTheme).
  const root = document.documentElement;
  const options = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-option]",
  );

  const showPreference = () => {
    options.forEach((option) => {
      const current =
        option.dataset.themeOption === root.dataset.themePreference;
      option.setAttribute("aria-pressed", current ? "true" : "false");
    });
  };

  options.forEach((option) => {
    option.addEventListener("click", () => {
      window.setDocsTheme(option.dataset.themeOption!);
      showPreference();
    });
  });

  showPreference();
</script>
