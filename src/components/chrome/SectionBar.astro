---
import { quietControl, strokeIcon } from "./docs-ui";
import TocToggle from "./TocToggle.astro";

// Below lg, a bar under the header: the nav drawer's toggle and "On this
// page". Fixed, not sticky, so it spans the viewport, not the centered .learn
// box; it follows the header's bottom edge (--spacing-header-offset). Outside
// the article, which is inert while the drawer is open. z 1000: above the
// drawer, so the toggle can close it, and below the header, so the ⋯ menu
// drops over it. Same side padding as the header row below lg.
---

<div class="tw:fixed tw:inset-x-0 tw:top-header-offset tw:z-1000 tw:flex tw:h-section-bar tw:items-center tw:justify-between tw:gap-3 tw:border-b tw:border-border tw:bg-surface tw:px-4 tw:shadow-header tw:motion-safe:transition-[top] tw:motion-safe:duration-200 tw:max-xs:px-3 tw:lg:hidden tw:print:hidden">
  {/* -6px lines the icon up with the header's logo above it. */}
  <button
    type="button"
    class:list={[
      quietControl,
      "tw:group tw:-ml-1.5 tw:flex tw:size-8 tw:shrink-0 tw:items-center tw:justify-center tw:p-0",
    ]}
    data-docs-nav-toggle
    aria-controls="main-navigation-content"
    aria-expanded="false"
    aria-label="Open navigation"
  >
    <svg
      class:list={[strokeIcon, "tw:group-aria-expanded:hidden"]}
      viewBox="0 0 20 20"
      aria-hidden="true"
    >
      <path d="M3 5h14M3 10h14M3 15h14" />
    </svg>
    <svg
      class:list={[strokeIcon, "tw:hidden tw:group-aria-expanded:block"]}
      viewBox="0 0 20 20"
      aria-hidden="true"
    >
      <path d="M5 5l10 10M15 5L5 15" />
    </svg>
  </button>
  <TocToggle />
</div>
