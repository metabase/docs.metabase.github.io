---
type Props = {
  page: {
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
  variant: "top-bar" | "inline";
};

type Crumb = { label: string; href?: string };

const { page, variant } = Astro.props;

const slugify = (str: string) =>
  str
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const categoryPath = (category: string) => {
  const slug = slugify(category);
  if (slug === "api") return "api-documentation";
  if (slug === "troubleshooting-guide") return `${slug}/`;
  return `${slug}/start`;
};

const getCrumbs = (page: Props["page"]): Crumb[] => {
  if (!page.has_magic_breadcrumbs) return [{ label: page.title ?? "" }];

  const root = `/docs/${page.url.split("/")[2]}/`;
  const crumbs: Crumb[] = [{ label: "Home", href: root }];
  if (page.show_category_breadcrumb && page.category) {
    crumbs.push({
      label: page.category,
      href: root + categoryPath(page.category),
    });
  }
  return crumbs;
};
---

<nav class:list={["trail", variant]} aria-label="breadcrumb">
  <ol>
    {getCrumbs(page).map(({ label, href }) => (
      <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  /* Doubled to outrank the legacy `.bootstrap .learn__post a` / `li` rules, which load later. */
  .trail.trail {
    ol {
      align-items: center;
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li {
      align-items: baseline;
      display: flex;
      margin: 0;
      position: relative;
      white-space: nowrap;
    }

    a {
      color: #509ee3;
    }

    span {
      color: #5a6072;
    }

    &.top-bar {
      li {
        font-size: 18px;
        line-height: 30px;
      }

      a {
        font-size: 16px;
        font-weight: 700;
      }

      li + li {
        padding-left: 23px;

        &::before {
          content: url("/images/chevron_blue_right.svg");
          left: 7px;
          position: absolute;
          top: 50%;
          transform: translateY(calc(-50% + 3px));
        }
      }

      @media (max-width: 991.98px) {
        display: none;
      }
    }

    &.inline {
      display: none;

      @media (max-width: 991.98px) {
        display: block;

        ol {
          margin: 16px 0;
        }

        li,
        a,
        span {
          color: #5a6072;
          font-size: 14px;
          font-weight: 400;
          line-height: 20px;
        }

        li + li::before {
          color: #c6c9d2;
          content: "/";
          padding: 0 6px;
        }
      }
    }
  }
</style>
