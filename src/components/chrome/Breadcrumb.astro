---
import { getCategoryUrl } from "@/lib/docs/nav";
import { baseCtx } from "@/lib/liquid/liquidRenderer";

type Props = {
  page: {
    version?: string;
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
  /** The plain slash-separated trail shown above the content on phones. */
  phone?: boolean;
};

const { page, phone = false } = Astro.props;
const { site } = baseCtx;

const latestOrExplicitVersion =
  site.docs_version === page.version && page.url.includes("/docs/latest/")
    ? "latest"
    : (page.version ?? "");

const getFallbackCategoryUrl = (version: string, url: string) => {
  // page.url is /docs/<version>/<category-slug>/...
  const categorySlug = url.split("/")[3] ?? "";
  const legacyMapping: Record<string, string> = {
    api: "api-documentation",
    "troubleshooting-guide": "troubleshooting-guide/",
  };
  const fallbackCategoryPath =
    legacyMapping[categorySlug] ?? `${categorySlug}/start`;
  return `/docs/${version}/${fallbackCategoryPath}`;
};

const categoryUrl =
  getCategoryUrl(latestOrExplicitVersion, page.category ?? "") ??
  getFallbackCategoryUrl(latestOrExplicitVersion, page.url);
---

<div class:list={["bootstrap", phone ? "phone-trail" : "bar-trail"]}>
  <nav
    style={
      phone
        ? "--bs-breadcrumb-divider: '/'"
        : "--bs-breadcrumb-divider: url('/images/chevron_blue_right.svg')"
    }
    aria-label="breadcrumb"
  >
    <ol class="breadcrumb">
      {page.has_magic_breadcrumbs ? (
        <>
          <li class="breadcrumb-item">
            {phone ? (
              <a
                href={`/docs/${latestOrExplicitVersion}/`}
                aria-label="Home"
                class="breadcrumb-home"
              >
                <svg
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M14 7.6 8 2 2 7.6M3.6 8.4V14h3.2v-3.2h2.4V14h3.2V8.4"
                  />
                </svg>
              </a>
            ) : (
              <a href={`/docs/${latestOrExplicitVersion}/`}>Home</a>
            )}
          </li>

          {page.title === "README" ? (
            <li class="breadcrumb-item">
              <p class="neutral-40">{page.category}</p>
            </li>
          ) : (
            page.show_category_breadcrumb && (
              <li class="breadcrumb-item">
                <a class="blue-60" href={categoryUrl}>
                  {page.category}
                </a>
              </li>
            )
          )}
        </>
      ) : (
        <li class="breadcrumb-item">
          <span class="neutral-40">{page.title}</span>
        </li>
      )}
    </ol>
  </nav>
</div>

<style>
  .phone-trail {
    display: none;
  }

  @media (max-width: 991.98px) {
    .bar-trail {
      display: none;
    }

    .phone-trail {
      display: block;
    }

    .breadcrumb-home {
      align-items: center;
      align-self: center;
      display: flex;
    }

    .phone-trail .breadcrumb,
    .phone-trail .breadcrumb-item {
      align-items: center;
    }

    .phone-trail .breadcrumb {
      margin: 16px 0;
    }

    .phone-trail .breadcrumb-item,
    .phone-trail .breadcrumb-item a,
    .phone-trail .breadcrumb-item span,
    .phone-trail .breadcrumb-item p {
      color: #5a6072;
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      margin: 0;
    }

    /* The legacy sheet positions the divider for the chevron image; the slash just flows inline. */
    .phone-trail .breadcrumb-item + .breadcrumb-item {
      padding-left: 0;
    }

    .phone-trail .breadcrumb-item + .breadcrumb-item::before {
      color: #c6c9d2;
      height: auto;
      left: auto;
      line-height: inherit;
      padding: 0 6px;
      position: static;
      transform: none;
    }
  }
</style>
