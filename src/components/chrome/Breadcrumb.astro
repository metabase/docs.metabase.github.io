---
import { getCategoryUrl } from "@/lib/docs/nav";

type Props = {
  page: {
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
  variant: "bar" | "inline";
};

type Crumb = { label: string; href?: string };

const { page, variant } = Astro.props;

// page.url is /docs/<version>/<category-slug>/...
const getFallbackCategoryPath = (url: string) => {
  const slug = url.split("/")[3] ?? "";
  if (slug === "api") return "api-documentation";
  if (slug === "troubleshooting-guide") return `${slug}/`;
  return `${slug}/start`;
};

const getCrumbs = ({ page }: Props): Crumb[] => {
  if (!page.has_magic_breadcrumbs) return [{ label: page.title ?? "" }];

  const version = page.url.split("/")[2];
  const root = `/docs/${version}/`;
  const crumbs: Crumb[] = [{ label: "Home", href: root }];
  if (page.show_category_breadcrumb && page.category) {
    crumbs.push({
      label: page.category,
      href:
        getCategoryUrl(version, page.category) ??
        root + getFallbackCategoryPath(page.url),
    });
  }
  return crumbs;
};
---

<nav class:list={["trail", variant]} aria-label="breadcrumb">
  <ol>
    {getCrumbs({ page, variant }).map(({ label, href }) => (
      <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  /* Doubled to outrank the legacy `.bootstrap .learn__post a` / `li` rules, which load later. */
  .trail.trail {
    ol {
      align-items: center;
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li {
      align-items: baseline;
      display: flex;
      margin: 0;
      position: relative;
      white-space: nowrap;
    }

    a {
      color: #509ee3;
    }

    span {
      color: #5a6072;
    }

    &.bar {
      li {
        font-size: 18px;
        line-height: 30px;
      }

      a {
        font-size: 16px;
        font-weight: 700;
      }

      li + li {
        padding-left: 23px;

        &::before {
          content: url("/images/chevron_blue_right.svg");
          left: 7px;
          position: absolute;
          top: 50%;
          transform: translateY(calc(-50% + 3px));
        }
      }

      @media (max-width: 991.98px) {
        display: none;
      }
    }

    &.inline {
      display: none;

      @media (max-width: 991.98px) {
        display: block;

        ol {
          margin: 16px 0;
        }

        li,
        a,
        span {
          color: #5a6072;
          font-size: 14px;
          font-weight: 400;
          line-height: 20px;
        }

        li + li::before {
          color: #c6c9d2;
          content: "/";
          padding: 0 6px;
        }
      }
    }
  }
</style>
