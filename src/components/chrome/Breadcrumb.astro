---
import { getDocBreadcrumbs } from "@/lib/docs/breadcrumbs";
import { baseCtx } from "@/lib/liquid/liquidRenderer";

type Props = {
  page: {
    version?: string;
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
};

const { page } = Astro.props;
const { site } = baseCtx;

const version = page.version === "latest" ? site.docs_version : page.version;
const [home, category] = page.has_magic_breadcrumbs
  ? getDocBreadcrumbs(page)
  : [];
---

{/* Bootstrap breadcrumb from the vendored bundle. The utilities (the `*:`
    ones style each crumb) let a long trail shrink and end in an ellipsis
    inside NewDocsLayout's top bar instead of running past its end. */}
<div class="bootstrap tw:min-w-0">
  <nav
    class="tw:min-w-0"
    style="--bs-breadcrumb-divider: url('/images/chevron_blue_right.svg')"
    aria-label="breadcrumb"
  >
    <ol class="breadcrumb tw:ml-0 tw:w-auto tw:*:whitespace-nowrap tw:*:last:min-w-0 tw:*:last:*:truncate">
      {home ? (
        <>
          <li class="breadcrumb-item">
            <a class="tw:rounded-sm tw:focus-ring" href={home.url}>
              {home.name}
            </a>
          </li>

          {category &&
            (category.url ? (
              <li class="breadcrumb-item">
                <a
                  class="blue-60 tw:rounded-sm tw:focus-ring"
                  href={category.url}
                >
                  {category.name}
                </a>
              </li>
            ) : (
              <li class="breadcrumb-item">
                <p class="tw:text-secondary">{category.name}</p>
              </li>
            ))}
        </>
      ) : (
        <>
          {page.title === "Search" ? (
            <li class="breadcrumb-item">
              <span class="m-0 paragraph-5 fw-bold tw:text-secondary">
                <a href="/docs/latest/">{site.latest_version}</a>
              </span>
            </li>
          ) : (
            <li class="breadcrumb-item">
              <span class="tw:text-secondary">{version}</span>
            </li>
          )}

          {page.category === "Api" && (
            <li class="breadcrumb-item">
              <span class="tw:text-secondary">{page.category}</span>
            </li>
          )}
          {page.title !== "README" && (
            <li class="breadcrumb-item">
              <span class="tw:text-secondary">{page.title}</span>
            </li>
          )}
        </>
      )}
    </ol>
  </nav>
</div>
