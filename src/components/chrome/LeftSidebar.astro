---
import DocsVersionSelector from "@/components/chrome/DocsVersionSelector.astro";
import NavItem from "@/components/chrome/NavItem.astro";
import type { NavNode, Section } from "@/lib/docs/nav";
import { navLink } from "./docs-ui";

// One category's pages; the header tabs switch categories. The section list
// stands in for the tabs in the mobile drawer.
//
// Below lg the sidebar is a drawer, open while <html> has data-docs-nav="open"
// (the script below; the `nav-open:` variant). visibility keeps the closed
// drawer's links out of the tab order and transitions with the slide, so the
// drawer stays visible until the slide-out ends. motion-safe, because a
// `motion-reduce:` reset would lose to `max-lg:`. It sits under the section
// bar (z 1000), so the bar's toggle can close it.
type Props = {
  url: string;
  version: string;
  category?: NavNode;
  sections: Section[];
};

const { url: pageUrl, version, category, sections } = Astro.props;

// The lists keep the vendored margins (16px top-level, 9px above a group's
// pages); the layout was tuned with them.
const list = "tw:list-none tw:p-0";
---

{/* Desktop padding: 8px link padding + 12px aligns nav text with the header
    wordmark at 20px. */}
<div
  class="tw:sticky tw:top-header tw:h-[calc(100vh-var(--tw-spacing-header))] tw:overflow-y-auto tw:border-r tw:border-border-subtle tw:bg-surface tw:pt-7.5 tw:pr-2.5 tw:pb-6 tw:pl-3 tw:shadow-sidebar tw:max-lg:invisible tw:max-lg:fixed tw:max-lg:top-[calc(var(--tw-spacing-header-offset)+var(--tw-spacing-section-bar))] tw:max-lg:bottom-0 tw:max-lg:left-0 tw:max-lg:z-999 tw:max-lg:h-auto tw:max-lg:w-[min(320px,85vw)] tw:max-lg:-translate-x-full tw:max-lg:px-3 tw:max-lg:pt-4 tw:max-lg:pb-8 tw:max-lg:shadow-card tw:max-lg:motion-safe:transition-[translate,visibility] tw:max-lg:motion-safe:duration-250 tw:max-lg:nav-open:visible tw:max-lg:nav-open:translate-x-0 tw:print:hidden"
  id="main-navigation-content"
  tabindex="-1"
>
  {/* Sticky, because the sidebar scrolls to the current page on load. The
      negative margins stretch its background over the sidebar's padding, so
      links scroll under it out of sight; it keeps 16px of the top padding.
      Sticky offsets count from inside the padding, so the negative top
      (the padding) puts it at the very top. */}
  <div class="tw:sticky tw:-top-7.5 tw:z-10 tw:-mx-3 tw:-mt-4 tw:mb-1 tw:bg-surface tw:px-3 tw:pt-4 tw:pb-2 tw:max-lg:-top-4 tw:lg:-mr-2.5 tw:lg:pr-2.5">
    <DocsVersionSelector version={version} pageUrl={pageUrl} />
  </div>
  <nav
    class="tw:max-lg:mb-3 tw:max-lg:border-b tw:max-lg:border-border-subtle tw:max-lg:pb-2 tw:lg:hidden"
    aria-label="Documentation sections"
  >
    <h5 class="tw:mb-1 tw:px-2 tw:pt-1 tw:pb-1.25 tw:text-[11px] tw:leading-normal tw:font-bold tw:tracking-[0.2em] tw:text-muted tw:uppercase">
      Sections
    </h5>
    <ul class={list}>
      {sections.map(({ name, href, active }) => (
        <li class="tw:m-0 tw:pb-1">
          <a
            href={href}
            class:list={[
              navLink,
              "tw:pr-2 tw:font-normal tw:text-secondary tw:hover:bg-surface-hover tw:hover:text-brand",
            ]}
            aria-current={active ? "page" : undefined}
          >
            {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {category && (
    <ul class={list}>
      {category.pages?.map((node, index) => (
        <NavItem node={node} pageUrl={pageUrl} depth={0} id={`nav-${index}`} />
      ))}
    </ul>
  )}
</div>

<script>
  import { belowLg } from "./breakpoints";

  const root = document.documentElement;
  const drawer = document.getElementById("main-navigation-content")!;

  // Mobile nav. Below lg the sidebar is a drawer, opened by the section bar's
  // toggle (SectionBar.astro).
  const toggle = document.querySelector<HTMLElement>("[data-docs-nav-toggle]");
  const backdrop = document.querySelector("[data-docs-nav-close]");
  // Inert while the drawer is open, so Tab and screen readers stay out of
  // the page behind the backdrop.
  const article = document.querySelector<HTMLElement>(".learn__post");

  const isOpen = () => root.dataset.docsNav === "open";

  // Center the current page in the sidebar. Only the page list (the direct
  // ul): the sections list above it marks its active section too.
  const centerCurrentPage = () => {
    const current = drawer.querySelector<HTMLElement>(
      ':scope > ul a[aria-current="page"]',
    );
    if (!current) return;
    drawer.scrollTop = Math.max(
      0,
      current.offsetTop - drawer.clientHeight / 2 + current.offsetHeight / 2,
    );
  };

  const setOpen = (open: boolean) => {
    if (open) {
      root.dataset.docsNav = "open";
    } else {
      delete root.dataset.docsNav;
    }
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    toggle?.setAttribute(
      "aria-label",
      open ? "Close navigation" : "Open navigation",
    );
    if (article) article.inert = open;

    if (!open) return;

    centerCurrentPage();
    drawer.focus({ preventScroll: true });
  };

  // On desktop the sticky sidebar scrolls; land on the current page instead
  // of the top.
  centerCurrentPage();

  toggle?.addEventListener("click", () => setOpen(!isOpen()));
  backdrop?.addEventListener("click", () => setOpen(false));

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });

  // The drawer only exists below lg; drop the open state (and its body
  // scroll lock) when the viewport grows past it.
  belowLg.addEventListener("change", (event) => {
    if (!event.matches && isOpen()) setOpen(false);
  });

  // A back/forward cache restore keeps the DOM as it was; start closed.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted && isOpen()) setOpen(false);
  });

  // Group toggles (NavItem.astro) open and close the group's page list.
  // Opening one closes the other open groups, except the ones it is in, so
  // one branch is open at a time. Topics have no toggle and stay open.
  drawer.addEventListener("click", (event) => {
    const groupToggle = (event.target as Element).closest("[data-nav-toggle]");
    const item = groupToggle?.closest("li");
    if (!groupToggle || !item) return;

    const expanded = !item.classList.contains("expanded");
    if (expanded) {
      drawer
        .querySelectorAll('[data-nav-toggle][aria-expanded="true"]')
        .forEach((other) => {
          const otherItem = other.closest("li");
          if (!otherItem || otherItem.contains(item)) return;
          otherItem.classList.remove("expanded");
          other.setAttribute("aria-expanded", "false");
        });
    }
    item.classList.toggle("expanded", expanded);
    groupToggle.setAttribute("aria-expanded", String(expanded));
  });
</script>
