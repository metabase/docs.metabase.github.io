---
import NavItem from "@/components/chrome/NavItem.astro";
import {
  getActiveCategory,
  getNavForVersion,
  getSections,
} from "@/lib/docs/nav";
import { navLink } from "./docs-ui";

// Only the active category's pages; the header tabs switch categories. Pages
// outside the nav (home, /docs/all) show the first category's pages. The
// section list is for the mobile drawer, where the header tabs are hidden.
// The category's top-level items are topics: always-open headings over their
// pages. Groups below them open when they contain the current page.
//
// At 992px and below the sidebar is a drawer, shown while <html> has
// data-docs-nav="open" (set by DocsHeader.astro, the `nav-open:` variant).
// visibility keeps the closed drawer's links out of the tab order; it
// transitions with the slide, which keeps the drawer visible until the
// slide-out ends. The transition is motion-safe only: a `motion-reduce:`
// reset would lose to `max-lg:`, which Tailwind emits later. It sits below
// the header (z 1001) and above the article.
type Props = {
  url: string;
  version: string;
};

const { url: pageUrl, version } = Astro.props;

const nav = getNavForVersion(version);
const category = getActiveCategory(nav, pageUrl) ?? nav.categories[0];
const sections = getSections(nav, pageUrl);

// The lists keep the vendored margins (16px top-level, 9px above a group's
// pages); the layout was tuned with them.
const list = "tw:list-none tw:p-0";
---

{/* Desktop padding: 8px link padding + 12px aligns nav text with the header
    wordmark at 20px. The shadow matches the header's (DocsHeader.astro). */}
<div
  class="tw:sticky tw:top-header tw:h-[calc(100vh-var(--tw-spacing-header))] tw:w-full tw:overflow-y-auto tw:border-r tw:border-border-subtle tw:bg-surface tw:pt-7.5 tw:pr-2.5 tw:pb-6 tw:pl-3 tw:shadow-sidebar tw:max-lg:invisible tw:max-lg:fixed tw:max-lg:bottom-0 tw:max-lg:left-0 tw:max-lg:z-1000 tw:max-lg:h-auto tw:max-lg:w-[min(320px,85vw)] tw:max-lg:-translate-x-full tw:max-lg:px-3 tw:max-lg:pt-4 tw:max-lg:pb-8 tw:max-lg:shadow-card tw:max-lg:motion-safe:transition-[translate,visibility] tw:max-lg:motion-safe:duration-250 tw:max-lg:nav-open:visible tw:max-lg:nav-open:translate-x-0"
  id="main-navigation-content"
  tabindex="-1"
>
  <nav
    class="tw:max-lg:mb-3 tw:max-lg:border-b tw:max-lg:border-border-subtle tw:max-lg:pb-2 tw:lg:hidden"
    aria-label="Documentation sections"
  >
    <h5 class="tw:mb-1 tw:px-2 tw:pt-1 tw:pb-1.25 tw:text-[11px] tw:leading-normal tw:font-bold tw:tracking-[0.2em] tw:text-muted tw:uppercase">
      Sections
    </h5>
    <ul class={list}>
      {sections.map(({ name, href, active }) => (
        <li class="tw:m-0 tw:pb-1">
          <a
            href={href}
            class:list={[
              navLink,
              "tw:pr-2 tw:text-secondary tw:hover:bg-surface-hover tw:hover:text-brand",
            ]}
            aria-current={active ? "page" : undefined}
          >
            {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {category && (
    <ul class={list}>
      {category.pages?.map((node) => (
        <NavItem node={node} pageUrl={pageUrl} depth={0} />
      ))}
    </ul>
  )}
</div>
