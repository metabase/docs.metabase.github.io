---
import NavItem from "@/components/chrome/NavItem.astro";
import {
  getActiveCategory,
  getNavForVersion,
  getSections,
} from "@/lib/docs/nav";

// Only the active category's pages; the header tabs switch categories. Pages
// outside the nav (home, /docs/all) show the first category's pages. The
// section list is for the mobile drawer, where the header tabs are hidden.
type Props = {
  url: string;
  version: string;
};

const { url: pageUrl, version } = Astro.props;

const nav = getNavForVersion(version);
const category = getActiveCategory(nav, pageUrl) ?? nav.categories[0];
const sections = getSections(nav, pageUrl);
---

<div class="learn-left-sidebar" id="main-navigation-content" tabindex="-1">
  <nav class="docs-sections" aria-label="Documentation sections">
    <h5>Sections</h5>
    <ul>
      {sections.map(({ name, href, active }) => (
        <li>
          <a
            href={href}
            class={active ? "selected" : ""}
            aria-current={active ? "page" : undefined}
          >
            {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {category && (
    <ul>
      {category.pages?.map((node) => (
        <NavItem node={node} pageUrl={pageUrl} open />
      ))}
    </ul>
  )}
</div>

{/* Base sidebar rules, colored with the docs-tokens.css tokens. The mobile
    drawer is in docs-local.css and is driven by DocsHeader.astro. */}
<style is:global>
  #main-navigation-content {
    background-color: var(--mb-surface);
    border-right: 1px solid var(--mb-border-subtle);
    box-shadow: 4px 2px 4px 0 var(--mb-shadow-chrome);
    height: calc(100vh - var(--navigation-header-height));
    overflow-y: auto;
    /* 8px link padding + 12px aligns nav text with the header wordmark at 20px. */
    padding: 30px 10px 0 12px;
    position: sticky;
    top: var(--navigation-header-height);
    width: 100%;

    h5 {
      color: var(--mb-text-muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      margin-bottom: 4px;
      padding: 4px 8px 5px;
      text-transform: uppercase;
    }

    ul {
      list-style: none;
      padding: 0;
    }

    li {
      margin: 0;
      padding: 0 0 4px;

      ul {
        display: none;
      }

      li {
        border-left: 1px solid var(--mb-border);
        padding-left: 10px;
      }

      li li {
        margin-left: 10px;
      }
    }

    li.expanded {
      > ul {
        display: block;
      }

      > a svg {
        transform: rotate(0);
      }
    }

    a {
      border-radius: 8px;
      color: var(--mb-text-secondary);
      display: block;
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      padding: 4px 38px 5px 8px;
      position: relative;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;

      &:hover,
      &.selected {
        background-color: var(--mb-surface-hover);
        color: var(--mb-brand);

        svg path {
          stroke: var(--mb-brand);
        }
      }

      &.selected {
        font-weight: 700;
      }

      > div {
        align-items: center;
        display: flex;
        height: 30px;
        justify-content: center;
        pointer-events: none;
        position: absolute;
        right: 2px;
        top: 50%;
        translate: 0 -50%;
        width: 30px;
      }

      svg {
        display: block;
        height: 12px;
        transform: rotate(-90deg);
        transition: transform 0.3s ease-in-out;
        width: 20px;
      }

      svg path {
        stroke: var(--mb-border-strong);
        transition: stroke 0.3s ease-in-out;
      }
    }
  }
</style>
