---
import NavItem from "@/components/chrome/NavItem.astro";
import {
  getActiveCategory,
  getLandingUrl,
  getNavForVersion,
} from "@/lib/docs/nav";

// Only the active category's pages, with top-level sections open; the header
// tabs switch categories. Pages outside the nav (home, /docs/all, 404) show
// the first category's pages but highlight no section, matching the header,
// which shows no active tab there. The section list is for the mobile drawer,
// where the header tabs are hidden; docs-local.css hides it on desktop.
type Props = {
  url: string;
  version?: string;
};

const { url: pageUrl, version = "latest" } = Astro.props;

const nav = getNavForVersion(version);
const active = getActiveCategory(nav, pageUrl);
const category = active ?? nav.categories[0];
---

<div class="learn-left-sidebar" id="main-navigation-content" tabindex="-1">
  <nav class="docs-sections" aria-label="Documentation sections">
    <h5>Sections</h5>
    <ul>
      {nav.categories.map((node) => (
        <li>
          <a
            href={getLandingUrl(node)}
            class={node === active ? "selected" : ""}
            aria-current={node === active ? "page" : undefined}
          >
            {node.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {category && (
    <ul>
      {category.pages?.map((node) => (
        <NavItem node={node} pageUrl={pageUrl} open />
      ))}
    </ul>
  )}
</div>

{/* Base sidebar rules. The mobile drawer is in docs-local.css and is driven by
    new-docs-mobile-nav.js; docs-theme.css recolors these with the theme tokens. */}
<style is:global>
  #main-navigation-content {
    border-right: 1px solid #f1f2f4;
    box-shadow: 4px 2px 4px 0 rgba(16, 24, 40, 0.05);
    height: calc(100vh - var(--navigation-header-height));
    overflow-y: auto;
    padding-right: 10px;
    padding-top: 80px;
    position: sticky;
    top: var(--navigation-header-height);
    width: 100%;

    h5 {
      color: #8d93a5;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.2em;
      margin-bottom: 4px;
      padding: 4px 8px 5px;
      text-transform: uppercase;
    }

    ul {
      list-style: none;
      padding: 0;
    }

    li {
      margin: 0;
      padding: 0 0 4px;

      ul {
        display: none;
      }

      li {
        border-left: 1px solid #e4ecfb;
        padding-left: 10px;
      }

      li li {
        margin-left: 10px;
      }
    }

    li.expanded {
      > ul {
        display: block;
      }

      > a svg {
        transform: rotate(0);
      }
    }

    a {
      border-radius: 8px;
      color: #5a6072;
      display: block;
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      padding: 4px 38px 5px 8px;
      position: relative;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;

      &:hover,
      &.selected {
        background-color: #eef6fc;
        color: #509ee3;

        svg path {
          stroke: #509ee3;
        }
      }

      &.selected {
        font-weight: 700;
      }

      > div {
        align-items: center;
        display: flex;
        height: 30px;
        justify-content: center;
        pointer-events: none;
        position: absolute;
        right: 2px;
        top: 50%;
        translate: 0 -50%;
        width: 30px;
      }

      svg {
        display: block;
        height: 12px;
        transform: rotate(-90deg);
        transition: transform 0.3s ease-in-out;
        width: 20px;
      }

      svg path {
        stroke: #c6c9d2;
        transition: stroke 0.3s ease-in-out;
      }
    }
  }
</style>
