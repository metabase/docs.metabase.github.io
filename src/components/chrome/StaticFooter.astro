---
import footerTemplate from "./fragments/footer.html?raw";

const footerHtml = footerTemplate.replace(
  /© Metabase \d{4}/,
  `© Metabase ${new Date().getUTCFullYear()}`,
);
---

<Fragment set:html={footerHtml} />
<script is:inline src="/docs/js/status.js"></script>
<script is:inline src="/docs/js/fillout-form-fallback.js"></script>
