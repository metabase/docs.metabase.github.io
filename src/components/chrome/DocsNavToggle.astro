<button
  class="d-lg-none docs-nav-toggle"
  type="button"
  aria-controls="main-navigation-content"
  aria-expanded="false"
  aria-label="Open docs navigation"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M17,11H3c-0.6,0-1-0.4-1-1s0.4-1,1-1h14c0.6,0,1,0.4,1,1S17.6,11,17,11z M21,7H3C2.4,7,2,6.6,2,6s0.4-1,1-1h18c0.6,0,1,0.4,1,1S21.6,7,21,7z M21,15H3c-0.6,0-1-0.4-1-1s0.4-1,1-1h18c0.6,0,1,0.4,1,1S21.6,15,21,15z M17,19H3c-0.6,0-1-0.4-1-1s0.4-1,1-1h14c0.6,0,1,0.4,1,1S17.6,19,17,19z"></path>
  </svg>
</button>

<script>
  import { DOCS_NAV_EVENT, setDocsNavOpen } from "@/lib/docs-nav";

  const button = document.querySelector<HTMLElement>(".docs-nav-toggle")!;

  button.addEventListener("click", () =>
    setDocsNavOpen(button.getAttribute("aria-expanded") !== "true"),
  );
  document.addEventListener(DOCS_NAV_EVENT, (e) =>
    button.setAttribute("aria-expanded", String(e.detail.open)),
  );
</script>

<style>
  .docs-nav-toggle {
    appearance: none;
    background-color: transparent;
    border: 0;
    color: #5a6072;
    display: flex;
    flex-shrink: 0;
    padding: 8px;
    transition: color 0.3s ease;

    &:hover {
      color: #509ee3;
    }
  }
</style>
