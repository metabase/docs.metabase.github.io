---
import VersionTag from "@/components/chrome/VersionTag.astro";
import Chevron from "@/icons/chevron.svg";
import { baseCtx } from "@/lib/liquid/liquidRenderer";
import { menuItem, menuPanel, quietControl } from "./docs-ui";

// At the top of the left sidebar (LeftSidebar.astro). The trigger's
// aria-expanded drives the open state (dropdown.ts): `aria-expanded:` on the
// trigger itself, `group-aria-expanded:` on its chevron and
// `peer-aria-expanded:` on the menu that follows it.
type Props = {
  version: string;
};

const { version } = Astro.props;

const { available_versions: availableVersions, docs_version: docsVersion } =
  baseCtx.site as { available_versions: string[]; docs_version: string };

const currentLabel = version === "latest" ? docsVersion : version;

const otherVersions = [...availableVersions]
  .reverse()
  .slice(0, 10)
  .filter((v) => v !== currentLabel);
---

<div class="tw:relative" data-dropdown>
  {/* 8px left padding lines the label up with the nav link text. */}
  <button
    type="button"
    class:list={[
      quietControl,
      "tw:group tw:peer tw:flex tw:items-center tw:gap-1.5 tw:px-2 tw:py-1.5 tw:select-none",
    ]}
    aria-expanded="false"
    data-dropdown-trigger
  >
    {currentLabel}
    <VersionTag version={currentLabel} />
    <Chevron class="tw:size-3 tw:transition-[rotate] tw:duration-200 tw:group-aria-expanded:rotate-180" />
  </button>
  <ul class:list={[menuPanel, "tw:left-0"]}>
    {otherVersions.map((v) => (
      <li class="tw:m-0">
        <a
          href={`/docs/${v}/`}
          class:list={[
            menuItem,
            "tw:justify-between tw:text-secondary tw:hover:text-brand",
          ]}
        >
          <span>{v}</span>
          <VersionTag version={v} />
        </a>
      </li>
    ))}
    <li class="tw:m-0">
      <a class:list={[menuItem, "tw:font-bold tw:text-brand"]} href="/docs/all">
        See more
      </a>
    </li>
  </ul>
</div>

<script>
  import "./dropdown";
</script>
