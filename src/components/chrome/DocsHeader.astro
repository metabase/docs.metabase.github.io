---
import DocsVersionSelector from "@/components/chrome/DocsVersionSelector.astro";
import MetabaseWordmark from "@/icons/chrome/metabase-wordmark.svg";
import Stars from "@/icons/chrome/stars.svg";
import {
  getActiveCategory,
  getLandingUrl,
  getNavForVersion,
} from "@/lib/docs/nav";

// Docs header that replaces the marketing navbar on modern docs pages. Rendered
// outside `.bootstrap` so the marketing navbar styles don't apply; `navigation-header`
// and `#get-started-btn` are kept for navigation-header.js and use-custom-header-checkout-link.js.
type Props = {
  version?: string;
  pageUrl: string;
  checkoutHref?: string;
};

const {
  version = "latest",
  pageUrl,
  checkoutHref = "https://store.metabase.com/checkout",
} = Astro.props;

const nav = getNavForVersion(version);
const activeCategory = getActiveCategory(nav, pageUrl);

const tabs = nav.categories.map((category) => ({
  name: category.name,
  href: getLandingUrl(category),
  active: category === activeCategory,
}));
---

<header class="docs-header navigation-header">
  <div class="docs-header__row docs-header__main">
    <a
      class="docs-header__brand"
      href={`/docs/${version}/`}
      aria-label="Metabase docs home"
    >
      <MetabaseWordmark />
      <span class="docs-header__docs">docs</span>
    </a>

    <div class="docs-header__search">
      <div id="inkeep"></div>
      <button
        type="button"
        class="docs-header__ask"
        data-inkeep-ask-ai
        aria-label="Ask AI"
      >
        <span class="docs-header__ask-label">Ask AI</span>
        <Stars />
      </button>
    </div>

    <div class="docs-header__actions">
      <a class="docs-header__home" href="/">
        Metabase home
      </a>
      <a id="get-started-btn" class="docs-header__cta" href={checkoutHref}>
        Get started
      </a>
    </div>
  </div>

  <nav
    class="docs-header__row docs-header__tabs"
    aria-label="Documentation sections"
  >
    {tabs.length > 0 && (
      <ul class="docs-header__tab-list">
        {tabs.map((tab) => (
          <li>
            <a
              class="docs-header__tab"
              href={tab.href}
              aria-current={tab.active ? "page" : undefined}
            >
              {tab.name}
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="docs-header__version">
      <DocsVersionSelector version={version} />
    </div>
  </nav>
</header>

<script is:inline src="/docs/js/inkeep.js" type="module" defer></script>

<style is:global>
  /* Read by inkeep.css to keep the search modal below the fixed header. */
  :root {
    --navigation-header-height: 108px;
  }
</style>

<style>
  .docs-header {
    background-color: #fff;
    border-bottom: 1px solid #e4ecfb;
    font-family: Lato, "Helvetica Neue", Helvetica, sans-serif;
    position: sticky;
    top: 0;
    z-index: 10000;
  }

  .docs-header__row {
    align-items: center;
    display: flex;
    gap: 16px;
    padding: 0 20px;
  }

  .docs-header__main {
    height: 64px;
  }

  .docs-header__brand {
    align-items: center;
    display: flex;
    flex: 1 1 0;
    gap: 8px;
    min-width: 0;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .docs-header__brand:hover {
    opacity: 0.75;
  }

  .docs-header__brand svg {
    flex-shrink: 0;
    height: 24px;
    max-width: none;
    width: auto;
  }

  /* Matches the wordmark's "Metabase", which is Lato Bold with a 12.2px cap
     height when the SVG renders at 24px (17px Lato). The 24px line box plus
     1px bottom padding puts the text baseline on the wordmark's baseline. */
  .docs-header__docs {
    color: #509ee3;
    font-size: 17px;
    font-weight: 700;
    line-height: 24px;
    padding-bottom: 1px;
  }

  .docs-header__search {
    align-items: center;
    display: flex;
    flex: 0 1 560px;
    gap: 8px;
    justify-content: center;
    min-width: 0;
  }

  .docs-header__search #inkeep {
    flex: 1 1 auto;
    height: 40px;
    min-width: 120px;
  }

  .docs-header__ask {
    align-items: center;
    background-color: #fff;
    border: 1px solid #e4ecfb;
    border-radius: 8px;
    color: #5a6072;
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    font-family: inherit;
    font-size: 14px;
    gap: 6px;
    height: 40px;
    padding: 0 12px;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .docs-header__ask:hover {
    background-color: #eef6fc;
    color: #509ee3;
  }

  .docs-header__ask svg {
    height: 16px;
    width: 16px;
  }

  .docs-header__actions {
    align-items: center;
    display: flex;
    flex: 1 1 0;
    gap: 8px;
    justify-content: flex-end;
  }

  /* Quiet text button back to the marketing site. Same type size, height,
     and padding as the CTA beside it so the pair reads as one button group. */
  .docs-header__home {
    border-radius: 8px;
    color: #5a6072;
    font-size: 14px;
    line-height: 20px;
    padding: 10px 14px;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__home:hover {
    background-color: #e4ecfb;
    color: #509ee3;
  }

  .docs-header__cta {
    background-color: #509ee3;
    border-radius: 8px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    line-height: 16px;
    padding: 12px 18px;
    text-decoration: none;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__cta:hover {
    background-color: #1c6bb0;
    color: #fff;
  }

  .docs-header__tabs {
    height: 44px;
  }

  /* Pins the version selector to the far right, apart from the section tabs,
     even when there is no tab list. */
  .docs-header__version {
    display: flex;
    flex-shrink: 0;
    margin-left: auto;
  }

  .docs-header__tab-list {
    align-items: stretch;
    display: flex;
    flex: 1 1 auto;
    gap: 8px;
    height: 100%;
    list-style: none;
    margin: 0;
    min-width: 0;
    overflow-x: auto;
    padding: 0;
    scrollbar-width: none;
  }

  .docs-header__tab-list li {
    display: flex;
    flex-shrink: 0;
    margin: 0;
  }

  .docs-header__tab {
    align-items: center;
    border-bottom: 2px solid transparent;
    border-radius: 8px 8px 0 0;
    color: #5a6072;
    display: flex;
    font-size: 14px;
    line-height: 20px;
    padding: 0 8px;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__tab:hover {
    background-color: #f9fbfc;
    color: #509ee3;
  }

  .docs-header__tab[aria-current="page"] {
    border-bottom-color: #509ee3;
    color: #509ee3;
    font-weight: 700;
  }

  .docs-header a:focus-visible,
  .docs-header button:focus-visible {
    border-radius: 8px;
    outline: 2px solid #509ee3;
    outline-offset: 2px;
  }

  /* Tabs fill the 44px row, so keep the ring inside it to avoid clipping. */
  .docs-header__tab:focus-visible {
    outline-offset: -2px;
  }

  @media screen and (max-width: 992px) {
    .docs-header__row {
      gap: 12px;
      padding: 0 16px;
    }

    .docs-header__brand,
    .docs-header__actions {
      flex: 0 0 auto;
    }

    .docs-header__docs,
    .docs-header__home,
    .docs-header__ask-label {
      display: none;
    }

    .docs-header__search {
      flex: 1 1 auto;
    }

    .docs-header__ask {
      padding: 0 10px;
    }
  }

  @media screen and (max-width: 480px) {
    .docs-header__search #inkeep {
      min-width: 0;
    }

    /* The search modal has its own "Ask" toggle, so drop the separate button. */
    .docs-header__ask {
      display: none;
    }

    .docs-header__cta {
      padding: 10px 12px;
    }
  }
</style>
