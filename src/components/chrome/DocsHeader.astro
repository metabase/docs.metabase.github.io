---
import DocsVersionSelector from "@/components/chrome/DocsVersionSelector.astro";
import InkeepSearch from "@/components/InkeepSearch/InkeepSearch.astro";
import MetabaseWordmark from "@/icons/chrome/metabase-wordmark.svg";
import Moon from "@/icons/chrome/moon.svg";
import Sun from "@/icons/chrome/sun.svg";
import Stars from "@/icons/stars.svg";
import {
  getActiveCategory,
  getNavForVersion,
  getSections,
} from "@/lib/docs/nav";

// Rendered outside `.bootstrap` so the marketing navbar styles don't apply.
// navigation-header.js needs `navigation-header`, and
// use-custom-header-checkout-link.js needs `#get-started-btn`.
type Props = {
  version: string;
  pageUrl: string;
  /** The page renders a LeftSidebar, which the menu button opens as a drawer. */
  sidebar?: boolean;
};

const { version, pageUrl, sidebar = false } = Astro.props;

const nav = getNavForVersion(version);
const activeCategory = getActiveCategory(nav, pageUrl);
const tabs = getSections(nav, pageUrl);
---

<header
  class:list={[
    "docs-header",
    "navigation-header",
    { "docs-header--with-nav": sidebar },
  ]}
>
  <div class="docs-header__row docs-header__main">
    <a
      class="docs-header__brand"
      href={`/docs/${version}/`}
      aria-label="Metabase docs home"
    >
      <MetabaseWordmark />
      <span class="docs-header__docs">docs</span>
    </a>

    <div class="docs-header__search">
      <InkeepSearch />
      <button
        type="button"
        class="docs-header__ask"
        data-inkeep-ask-ai
        aria-label="Ask AI"
      >
        <span class="docs-header__ask-label">Ask AI</span>
        <Stars />
      </button>
    </div>

    <div class="docs-header__actions">
      <a class="docs-header__whats-new docs-header__quiet" href="/releases">
        What’s new
      </a>
      <a class="docs-header__home docs-header__quiet" href="/">
        Metabase home
      </a>
      <a
        id="get-started-btn"
        class="docs-header__cta"
        href="https://store.metabase.com/checkout"
      >
        Get started
      </a>
    </div>
  </div>

  <nav
    class="docs-header__row docs-header__tabs"
    aria-label="Documentation sections"
  >
    {sidebar && (
      <button
        type="button"
        class="docs-header__menu docs-header__quiet"
        data-docs-nav-toggle
        aria-controls="main-navigation-content"
        aria-expanded="false"
        aria-label="Open navigation"
      >
        <svg
          class="docs-header__menu-open"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M3 5h14M3 10h14M3 15h14" />
        </svg>
        <svg
          class="docs-header__menu-close"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
        <span class="docs-header__menu-label">
          {activeCategory?.name ?? "Menu"}
        </span>
      </button>
    )}
    {tabs.length > 0 && (
      <ul class="docs-header__tab-list">
        {tabs.map((tab) => (
          <li>
            <a
              class="docs-header__tab"
              href={tab.href}
              aria-current={tab.active ? "page" : undefined}
            >
              {tab.name}
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="docs-header__version">
      <button
        type="button"
        class="docs-header__theme docs-header__quiet"
        data-theme-toggle
        aria-label="Switch to dark theme"
      >
        <Sun />
        <Moon />
      </button>
      <DocsVersionSelector version={version} />
    </div>
  </nav>
</header>

<script>
  // Same key as _includes/docs/theme-init.js, which sets data-theme before
  // first paint.
  const THEME_KEY = "mb-docs-theme";
  const root = document.documentElement;
  const themeButton = document.querySelector("[data-theme-toggle]");

  const getTheme = () => (root.dataset.theme === "dark" ? "dark" : "light");

  const hasStoredPreference = () => {
    try {
      const stored = localStorage.getItem(THEME_KEY);
      return stored === "light" || stored === "dark";
    } catch {
      return false;
    }
  };

  const syncButton = (theme: string) => {
    const label =
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  };

  const applyTheme = (theme: string, persist: boolean) => {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem(THEME_KEY, theme);
      } catch {
        /* storage blocked; the choice lasts for this page only */
      }
    }
    syncButton(theme);
    // new-docs-code-snippet-copy.js swaps its icons on this.
    document.dispatchEvent(new CustomEvent("themechange"));
  };

  syncButton(getTheme());
  themeButton?.addEventListener("click", () => {
    applyTheme(getTheme() === "dark" ? "light" : "dark", true);
  });

  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    if (!hasStoredPreference()) applyTheme(e.matches ? "dark" : "light", false);
  });

  // Mobile nav. At 992px and below docs-local.css turns the left sidebar into
  // a drawer, which it shows while <html> has data-docs-nav="open".
  const toggle = document.querySelector<HTMLElement>("[data-docs-nav-toggle]");
  const drawer = document.getElementById("main-navigation-content");

  // Pages without a sidebar (404) have neither.
  if (toggle && drawer) {
    const backdrop = document.querySelector("[data-docs-nav-close]");
    // Inert while the drawer is open, so Tab and screen readers stay out of
    // the page behind the backdrop.
    const article = document.querySelector<HTMLElement>(".learn__post");

    const isOpen = () => root.dataset.docsNav === "open";

    const setOpen = (open: boolean) => {
      if (open) {
        root.dataset.docsNav = "open";
      } else {
        delete root.dataset.docsNav;
      }
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation" : "Open navigation",
      );
      if (article) article.inert = open;

      if (!open) return;

      // Center the current page in the drawer. Only the page list (the direct
      // ul): the sections list above it marks its active section .selected too.
      const current = drawer.querySelector<HTMLElement>(
        ":scope > ul a.selected",
      );
      if (current) {
        drawer.scrollTop = Math.max(
          0,
          current.offsetTop -
            drawer.clientHeight / 2 +
            current.offsetHeight / 2,
        );
      }
      drawer.focus({ preventScroll: true });
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));
    backdrop?.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      setOpen(false);
      toggle.focus();
    });

    // The drawer only exists below 993px; drop the open state (and its body
    // scroll lock) when the viewport grows past it.
    matchMedia("(min-width: 993px)").addEventListener("change", (event) => {
      if (event.matches && isOpen()) setOpen(false);
    });

    // A back/forward cache restore keeps the DOM as it was; start closed.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted && isOpen()) setOpen(false);
    });
  }
</script>

<style is:global>
  /* html:root outranks the marketing navbar's value, which styles.css sets on
     :root. inkeep.css and docs-local.css read --navigation-header-height to
     keep the search modal and sticky sidebars below the header. */
  html:root {
    --docs-header-main-height: 64px;
    --docs-header-tabs-height: 44px;
    /* + 1px for .docs-header's border-bottom, which sits below the two rows. */
    --navigation-header-height: calc(
      var(--docs-header-main-height) + var(--docs-header-tabs-height) + 1px
    );
  }
</style>

<style>
  .docs-header {
    background-color: var(--mb-surface);
    border-bottom: 1px solid var(--mb-border);
    /* Matches the left sidebar's shadow (LeftSidebar.astro). */
    box-shadow: 2px 4px 4px 0 var(--mb-shadow-chrome);
    /* Set here because the body font in docs-local.css needs data-theme,
       which only theme-init.js sets. */
    font-family: Lato, "Helvetica Neue", Helvetica, sans-serif;
    position: sticky;
    top: 0;
    /* Below the image-zoom overlay (2000) and the search modal (100000). */
    z-index: 1001;
  }

  .docs-header__row {
    align-items: center;
    display: flex;
    gap: 16px;
    padding: 0 20px;
  }

  .docs-header__main {
    height: var(--docs-header-main-height);
  }

  .docs-header__brand {
    align-items: center;
    color: var(--mb-text-secondary);
    display: flex;
    flex: 1 1 0;
    gap: 4px;
    min-width: 0;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .docs-header__brand:hover {
    opacity: 0.75;
  }

  /* The wordmark text is currentColor; secondary text is too dim on dark
     surfaces. */
  :global([data-theme="dark"]) .docs-header__brand {
    color: var(--mb-heading);
  }

  .docs-header__brand svg {
    flex-shrink: 0;
    height: 24px;
    max-width: none;
    width: auto;
  }

  /* 17px Lato Bold matches the wordmark text at 24px; the 1px pad puts it on
     the wordmark's baseline. */
  .docs-header__docs {
    color: var(--mb-brand);
    font-size: 17px;
    font-weight: 700;
    line-height: 24px;
    padding-bottom: 1px;
  }

  .docs-header__search {
    align-items: center;
    display: flex;
    flex: 0 1 560px;
    gap: 8px;
    justify-content: center;
    min-width: 0;
  }

  .docs-header__search :global(#inkeep) {
    flex: 1 1 auto;
    height: 40px;
    min-width: 120px;
  }

  .docs-header__ask {
    align-items: center;
    background-color: var(--mb-surface);
    border: 1px solid var(--mb-border);
    border-radius: 8px;
    color: var(--mb-text-secondary);
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    font-family: inherit;
    font-size: 14px;
    gap: 6px;
    height: 40px;
    padding: 0 12px;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .docs-header__ask:hover,
  .docs-header__tab:hover {
    background-color: var(--mb-surface-hover);
    color: var(--mb-brand);
  }

  .docs-header__ask svg {
    height: 16px;
    width: 16px;
  }

  /* Color, radius and hover for the quiet controls (menu, theme, what's new,
     home); each pairs this with its own layout class. The version selector
     repeats these in DocsVersionSelector.astro, out of reach of this scope. */
  .docs-header__quiet {
    border-radius: 8px;
    color: var(--mb-text-secondary);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .docs-header__quiet:hover,
  .docs-header__quiet[aria-expanded="true"] {
    background-color: var(--mb-surface-active);
    color: var(--mb-brand);
  }

  .docs-header__theme {
    align-items: center;
    background: none;
    border: 0;
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    height: 32px;
    justify-content: center;
    padding: 0;
    width: 32px;
  }

  .docs-header__theme svg {
    height: 18px;
    width: 18px;
  }

  .docs-header__theme svg:last-child,
  :global([data-theme="dark"]) .docs-header__theme svg:first-child {
    display: none;
  }

  :global([data-theme="dark"]) .docs-header__theme svg:last-child {
    display: block;
  }

  .docs-header__actions {
    align-items: center;
    display: flex;
    flex: 1 1 0;
    gap: 8px;
    justify-content: flex-end;
  }

  /* 40px tall, like the CTA beside them. */
  .docs-header__whats-new,
  .docs-header__home {
    font-size: 14px;
    line-height: 20px;
    padding: 10px 14px;
    text-decoration: none;
    white-space: nowrap;
  }

  .docs-header__cta {
    background-color: var(--mb-brand);
    border-radius: 8px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    line-height: 16px;
    padding: 12px 18px;
    text-decoration: none;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__cta:hover {
    background-color: var(--mb-brand-hover);
    color: #fff;
  }

  .docs-header__tabs {
    height: var(--docs-header-tabs-height);
  }

  /* Shown at 992px and below on pages with a sidebar, in place of the tabs. */
  .docs-header__menu {
    align-items: center;
    background: none;
    border: 0;
    cursor: pointer;
    display: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    gap: 8px;
    height: 32px;
    line-height: 20px;
    /* -8px lines the icon up with the wordmark at the 16px row gutter. */
    margin-left: -8px;
    min-width: 0;
    padding: 0 8px;
  }

  .docs-header__menu svg {
    fill: none;
    flex-shrink: 0;
    height: 20px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.5;
    width: 20px;
  }

  .docs-header__menu[aria-expanded="true"] .docs-header__menu-open,
  .docs-header__menu:not([aria-expanded="true"]) .docs-header__menu-close {
    display: none;
  }

  .docs-header__menu-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* margin-left: auto pins it right even when there is no tab list. */
  .docs-header__version {
    align-items: center;
    display: flex;
    flex-shrink: 0;
    gap: 4px;
    margin-left: auto;
  }

  /* -8px cancels the first tab's own padding so its label lines up with the
     wordmark and the sidebar text at the 20px row gutter. */
  .docs-header__tab-list {
    align-items: stretch;
    display: flex;
    flex: 1 1 auto;
    gap: 8px;
    height: 100%;
    list-style: none;
    margin: 0 0 0 -8px;
    min-width: 0;
    overflow-x: auto;
    padding: 0;
    scrollbar-width: none;
  }

  .docs-header__tab-list li {
    display: flex;
    flex-shrink: 0;
    margin: 0;
  }

  .docs-header__tab {
    align-items: center;
    border-bottom: 2px solid transparent;
    border-radius: 8px 8px 0 0;
    color: var(--mb-text-secondary);
    display: flex;
    font-size: 14px;
    line-height: 20px;
    padding: 0 8px;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__tab[aria-current="page"] {
    border-bottom-color: var(--mb-brand);
    color: var(--mb-brand);
    font-weight: 700;
  }

  .docs-header a:focus-visible,
  .docs-header button:focus-visible {
    border-radius: 8px;
    outline: 2px solid var(--mb-brand);
    outline-offset: 2px;
  }

  /* Tabs fill the 44px row, so keep the ring inside it to avoid clipping. */
  .docs-header__tab:focus-visible {
    outline-offset: -2px;
  }

  /* Below 1200px the actions would squeeze the brand into the search box, so
     the release notes link goes first; the footer still links to it. */
  @media screen and (max-width: 1199.98px) {
    .docs-header__whats-new {
      display: none;
    }
  }

  @media screen and (max-width: 992px) {
    .docs-header__row {
      gap: 12px;
      padding: 0 16px;
    }

    .docs-header__brand,
    .docs-header__actions {
      flex: 0 0 auto;
    }

    .docs-header__docs,
    .docs-header__home,
    .docs-header__ask-label {
      display: none;
    }

    .docs-header__search {
      flex: 1 1 auto;
    }

    .docs-header__ask {
      padding: 0 10px;
    }

    /* The sections are listed in the drawer instead. */
    .docs-header--with-nav .docs-header__menu {
      display: flex;
    }

    .docs-header--with-nav .docs-header__tab-list {
      display: none;
    }

    /* Without a sidebar (404), the tab list scrolls with its scrollbar
       hidden, so fade its right edge to show there is more. */
    .docs-header__tab-list {
      mask-image: linear-gradient(
        to right,
        #000 calc(100% - 32px),
        transparent
      );
      padding-right: 32px;
    }
  }

  @media screen and (max-width: 480px) {
    .docs-header__search :global(#inkeep) {
      min-width: 0;
    }

    /* The search modal has its own "Ask" toggle, so drop the separate button. */
    .docs-header__ask {
      display: none;
    }

    .docs-header__cta {
      padding: 10px 12px;
    }
  }
</style>
