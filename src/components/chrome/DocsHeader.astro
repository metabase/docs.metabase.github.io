---
import DocsVersionSelector from "@/components/chrome/DocsVersionSelector.astro";
import MetabaseWordmark from "@/icons/chrome/metabase-wordmark.svg";
import Stars from "@/icons/chrome/stars.svg";
import {
  getActiveCategory,
  getLandingUrl,
  getNavForVersion,
} from "@/lib/docs/nav";

// Docs-specific header (replaces the marketing navbar on modern docs pages):
// row 1 is wordmark / search + Ask AI / Get started, row 2 is one tab per
// top-level nav.yml category plus the version selector.
//
// Rendered outside any `.bootstrap` wrapper on purpose: the marketing
// `.bootstrap .navigation-header …` rules in styles.css don't apply here, but
// the `navigation-header` class and `#get-started-btn` id are kept so
// navigation-header.js (?hide_nav=true) and use-custom-header-checkout-link.js
// keep working.
type Props = {
  version?: string;
  pageUrl: string;
  checkoutHref?: string;
};

const {
  version = "latest",
  pageUrl,
  checkoutHref = "https://store.metabase.com/checkout",
} = Astro.props;

const nav = getNavForVersion(version);
const activeCategory = getActiveCategory(nav, pageUrl);

const tabs = nav.categories.map((category) => ({
  name: category.name,
  href: getLandingUrl(category),
  active: category === activeCategory,
}));
---

<header class="docs-header navigation-header" data-docs-header>
  <div class="docs-header__row docs-header__main">
    <div class="docs-header__brand">
      <a class="docs-header__logo" href="/" aria-label="Metabase home">
        <MetabaseWordmark />
      </a>
      <a class="docs-header__docs" href={`/docs/${version}/`}>
        Docs
      </a>
    </div>

    <div class="docs-header__search">
      <div id="inkeep"></div>
      <button
        type="button"
        class="docs-header__ask"
        data-inkeep-ask-ai
        aria-label="Ask AI"
      >
        <span class="docs-header__ask-label">Ask AI</span>
        <Stars />
      </button>
    </div>

    <div class="docs-header__actions">
      <a id="get-started-btn" class="docs-header__cta" href={checkoutHref}>
        Get started
      </a>
    </div>
  </div>

  <nav
    class="docs-header__row docs-header__tabs"
    aria-label="Documentation sections"
  >
    {tabs.length > 0 && (
      <ul class="docs-header__tab-list">
        {tabs.map((tab) => (
          <li>
            <a
              class="docs-header__tab"
              href={tab.href}
              aria-current={tab.active ? "page" : undefined}
            >
              {tab.name}
            </a>
          </li>
        ))}
      </ul>
    )}
    <DocsVersionSelector version={version} />
  </nav>
</header>

<script is:inline src="/docs/js/inkeep.js" type="module" defer></script>

<script>
  if (new URLSearchParams(window.location.search).get("hide_nav") === "true") {
    document
      .querySelector<HTMLElement>("[data-docs-header]")
      ?.setAttribute("hidden", "");
  }
</script>

<style is:global>
  /* Read by inkeep.css to keep the search modal below the fixed header. */
  :root {
    --navigation-header-height: 108px;
  }
</style>

<style>
  .docs-header {
    background-color: #fff;
    border-bottom: 1px solid #e4ecfb;
    font-family: Lato, "Helvetica Neue", Helvetica, sans-serif;
    position: sticky;
    top: 0;
    z-index: 10000;
  }

  .docs-header[hidden] {
    display: none;
  }

  .docs-header__row {
    align-items: center;
    display: flex;
    gap: 16px;
    padding: 0 20px;
  }

  .docs-header__main {
    height: 64px;
  }

  .docs-header__brand {
    align-items: center;
    display: flex;
    flex: 1 1 0;
    gap: 8px;
    min-width: 0;
  }

  .docs-header__logo {
    display: flex;
    flex-shrink: 0;
  }

  .docs-header__logo svg {
    height: 24px;
    max-width: none;
    width: auto;
  }

  .docs-header__docs {
    color: #509ee3;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .docs-header__search {
    align-items: center;
    display: flex;
    flex: 0 1 560px;
    gap: 8px;
    justify-content: center;
    min-width: 0;
  }

  .docs-header__search #inkeep {
    flex: 1 1 auto;
    height: 40px;
    min-width: 120px;
  }

  .docs-header__ask {
    align-items: center;
    background-color: #fff;
    border: 1px solid #e4ecfb;
    border-radius: 6px;
    color: #5a6072;
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    font-family: inherit;
    font-size: 14px;
    gap: 6px;
    height: 40px;
    padding: 0 12px;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .docs-header__ask:hover {
    background-color: #eef6fc;
    color: #509ee3;
  }

  .docs-header__ask svg {
    height: 16px;
    width: 16px;
  }

  .docs-header__actions {
    display: flex;
    flex: 1 1 0;
    justify-content: flex-end;
  }

  .docs-header__cta {
    background-color: #509ee3;
    border-radius: 8px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    line-height: 16px;
    padding: 12px 18px;
    text-decoration: none;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__cta:hover {
    background-color: #1c6bb0;
    color: #fff;
  }

  .docs-header__tabs {
    border-top: 1px solid #f1f2f4;
    height: 44px;
    justify-content: space-between;
  }

  /* Keeps the version selector right-aligned on versions without a nav.yml. */
  .docs-header__tabs > :last-child {
    margin-left: auto;
  }

  .docs-header__tab-list {
    align-items: stretch;
    display: flex;
    gap: 8px;
    height: 100%;
    list-style: none;
    margin: 0;
    min-width: 0;
    overflow-x: auto;
    padding: 0;
    scrollbar-width: none;
  }

  .docs-header__tab-list li {
    display: flex;
    flex-shrink: 0;
    margin: 0;
  }

  .docs-header__tab {
    align-items: center;
    border-bottom: 2px solid transparent;
    color: #5a6072;
    display: flex;
    font-size: 14px;
    line-height: 20px;
    padding: 0 8px;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
    white-space: nowrap;
  }

  .docs-header__tab:hover {
    color: #509ee3;
  }

  .docs-header__tab[aria-current="page"] {
    border-bottom-color: #509ee3;
    color: #509ee3;
    font-weight: 700;
  }

  @media screen and (max-width: 992px) {
    .docs-header__row {
      gap: 12px;
      padding: 0 16px;
    }

    .docs-header__brand,
    .docs-header__actions {
      flex: 0 0 auto;
    }

    .docs-header__docs,
    .docs-header__ask-label {
      display: none;
    }

    .docs-header__search {
      flex: 1 1 auto;
    }

    .docs-header__ask {
      padding: 0 10px;
    }
  }

  @media screen and (max-width: 480px) {
    .docs-header__search #inkeep {
      min-width: 0;
    }

    /* The search modal has its own "Ask" toggle, so drop the separate button. */
    .docs-header__ask {
      display: none;
    }

    .docs-header__cta {
      padding: 10px 12px;
    }
  }
</style>
