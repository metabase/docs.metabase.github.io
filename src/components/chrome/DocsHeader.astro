---
import InkeepSearch from "@/components/InkeepSearch/InkeepSearch.astro";
import Book from "@/icons/chrome/book.svg";
import MetabaseMark from "@/icons/chrome/metabase-mark.svg";
import MetabaseWordmark from "@/icons/chrome/metabase-wordmark.svg";
import { getNavForVersion, getSections } from "@/lib/docs/nav";
import { iconButton, quietControl } from "./docs-ui";
import DocsMoreMenu from "./DocsMoreMenu.astro";

// Rendered outside `.bootstrap` so the marketing navbar styles don't apply.
// navigation-header.js needs `navigation-header`, and
// use-custom-header-checkout-link.js needs `#get-started-btn`.
//
// One row, --spacing-header-row tall (src/styles/docs.css); --spacing-header
// (the row plus the border) keeps the search modal, the sticky sidebars and
// the drawer below the header. The version selector is at the top of the
// left sidebar; the theme toggle is in the ⋯ menu.
type Props = {
  version: string;
  pageUrl: string;
  /** The page renders a LeftSidebar, which the menu button opens as a drawer. */
  sidebar?: boolean;
};

const { version, pageUrl, sidebar = false } = Astro.props;

const tabs = getSections(getNavForVersion(version), pageUrl);

const icon =
  "tw:size-5 tw:shrink-0 tw:fill-none tw:stroke-current tw:stroke-[1.5] tw:[stroke-linecap:round]";
// The row's gaps, also used between the brand items.
const gap = "tw:gap-4 tw:max-lg:gap-3 tw:max-xs:gap-2";
---

{/* z-index: below the image-zoom overlay (2000) and the search modal (100000). */}
<header class="navigation-header tw:sticky tw:top-0 tw:z-1001 tw:border-b tw:border-border tw:bg-surface tw:shadow-header">
  <div
    class:list={[
      gap,
      "tw:flex tw:h-header-row tw:items-center tw:px-5 tw:max-lg:px-4 tw:max-xs:px-3",
    ]}
  >
    {/* Below lg in place of the tabs; the drawer lists the sections. -6px
        lines the icon up with the row gutter. Phones get tighter gaps and
        gutters so the row fits at 320px. */}
    {sidebar && (
      <button
        type="button"
        class:list={[
          quietControl,
          "tw:group tw:-ml-1.5 tw:flex tw:size-8 tw:shrink-0 tw:items-center tw:justify-center tw:p-0 tw:lg:hidden",
        ]}
        data-docs-nav-toggle
        aria-controls="main-navigation-content"
        aria-expanded="false"
        aria-label="Open navigation"
      >
        <svg
          class:list={[icon, "tw:group-aria-expanded:hidden"]}
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M3 5h14M3 10h14M3 15h14" />
        </svg>
        <svg
          class:list={[icon, "tw:hidden tw:group-aria-expanded:block"]}
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>
    )}

    <div class:list={[gap, "tw:flex tw:shrink-0 tw:items-center"]}>
      {/* The wordmark text is currentColor; secondary text is too dim on
          dark surfaces, so the brand goes heading-colored there. Phones get
          the mark only. */}
      <a
        class="tw:flex tw:items-center tw:text-secondary tw:no-underline tw:transition-opacity tw:hover:opacity-75 tw:focus-ring tw:dark:text-heading"
        href="/"
        aria-label="Metabase home"
      >
        <MetabaseWordmark class="tw:h-6 tw:w-auto tw:max-w-none tw:shrink-0 tw:max-xs:hidden" />
        <MetabaseMark class="tw:h-6 tw:w-auto tw:shrink-0 tw:xs:hidden" />
      </a>
      <span
        class="tw:h-6 tw:w-px tw:bg-border-strong"
        aria-hidden="true"
      ></span>
      {/* 17px Lato Bold matches the wordmark text at 24px; the 1px pad puts
          it on the wordmark's baseline. The book's paths have a fixed stroke,
          so stroke-current gives them the link color. Phones drop the book
          so the row fits at 320px. */}
      <a
        class="tw:flex tw:items-center tw:gap-1.5 tw:pb-px tw:text-[17px]/6 tw:font-bold tw:text-brand tw:no-underline tw:transition-opacity tw:hover:opacity-75 tw:focus-ring"
        href={`/docs/${version}/`}
        aria-label="Metabase docs home"
      >
        <Book
          class="tw:size-5 tw:shrink-0 tw:**:stroke-current tw:max-xs:hidden"
          aria-hidden="true"
        />
        Docs
      </a>
    </div>

    {/* The tabs fill the row, so the active tab's underline sits on the
        header's border. They scroll if they run out of room. Without a
        sidebar (404) they also show below lg, with their scrollbar hidden and
        the right edge faded to show there is more. */}
    {tabs.length > 0 && (
      <nav
        class:list={[
          "tw:flex tw:h-full tw:min-w-0",
          { "tw:max-lg:hidden": sidebar },
        ]}
        aria-label="Documentation sections"
      >
        <ul
          class:list={[
            "tw:my-0 tw:flex tw:min-w-0 tw:scrollbar-none tw:list-none tw:gap-2 tw:overflow-x-auto tw:p-0",
            {
              "tw:max-lg:mask-r-from-[calc(100%-32px)] tw:max-lg:pr-8":
                !sidebar,
            },
          ]}
        >
          {tabs.map((tab) => (
            <li class="tw:m-0 tw:flex tw:shrink-0">
              {/* The focus ring stays inside the row. pt-1 drops the text
                  2px (half the pad) onto the wordmark's baseline. */}
              <a
                class="tw:flex tw:items-center tw:rounded-t-lg tw:border-b-2 tw:border-transparent tw:px-2 tw:pt-1 tw:text-sm/5 tw:whitespace-nowrap tw:text-secondary tw:no-underline tw:transition-[background-color,color,border-color] tw:hover:bg-surface-hover tw:hover:text-brand tw:focus-ring tw:focus-visible:-outline-offset-2 tw:aria-[current=page]:border-brand tw:aria-[current=page]:font-bold tw:aria-[current=page]:text-brand"
                href={tab.href}
                aria-current={tab.active ? "page" : undefined}
              >
                {tab.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {/* ml-auto pins it right whatever the tabs take. The search box needs
        room the tabs use below xl, so an icon opens the same modal there. */}
    <div class="tw:ml-auto tw:flex tw:shrink-0 tw:items-center tw:gap-2">
      <InkeepSearch class="tw:h-10 tw:w-64 tw:max-xl:hidden" />
      <button
        type="button"
        class:list={[iconButton, "tw:xl:hidden"]}
        data-inkeep-search
        aria-label="Search the docs or ask AI"
      >
        <svg class={icon} viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16.5 16.5l-3.4-3.4M3.5 9a5.5 5.5 0 1 1 11 0 5.5 5.5 0 0 1-11 0Z" />
        </svg>
      </button>
      <a
        id="get-started-btn"
        class="tw:rounded-lg tw:bg-brand tw:px-4.5 tw:py-3 tw:text-control/4 tw:font-bold tw:whitespace-nowrap tw:text-white tw:no-underline tw:transition-colors tw:hover:bg-brand-hover tw:focus-ring tw:max-xs:px-3 tw:max-xs:py-2.5"
        href="https://store.metabase.com/checkout"
      >
        Get started
      </a>
      <DocsMoreMenu />
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;

  // Mobile nav. Below lg LeftSidebar.astro turns the left sidebar
  // into a drawer, shown while <html> has data-docs-nav="open" (the
  // `nav-open:` variant in src/styles/docs.css).
  const toggle = document.querySelector<HTMLElement>("[data-docs-nav-toggle]");
  const drawer = document.getElementById("main-navigation-content");

  // Pages without a sidebar (404) have neither.
  if (toggle && drawer) {
    const backdrop = document.querySelector("[data-docs-nav-close]");
    // Inert while the drawer is open, so Tab and screen readers stay out of
    // the page behind the backdrop.
    const article = document.querySelector<HTMLElement>(".learn__post");

    const isOpen = () => root.dataset.docsNav === "open";

    // Center the current page in the sidebar. Only the page list (the direct
    // ul): the sections list above it marks its active section too.
    const centerCurrentPage = () => {
      const current = drawer.querySelector<HTMLElement>(
        ':scope > ul a[aria-current="page"]',
      );
      if (!current) return;
      drawer.scrollTop = Math.max(
        0,
        current.offsetTop - drawer.clientHeight / 2 + current.offsetHeight / 2,
      );
    };

    const setOpen = (open: boolean) => {
      if (open) {
        root.dataset.docsNav = "open";
      } else {
        delete root.dataset.docsNav;
      }
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation" : "Open navigation",
      );
      if (article) article.inert = open;

      if (!open) return;

      centerCurrentPage();
      drawer.focus({ preventScroll: true });
    };

    // On desktop the sticky sidebar scrolls; land on the current page instead
    // of the top.
    centerCurrentPage();

    toggle.addEventListener("click", () => setOpen(!isOpen()));
    backdrop?.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      setOpen(false);
      toggle.focus();
    });

    // The drawer only exists below lg; drop the open state (and its body
    // scroll lock) when the viewport grows past it. docs.css emits the
    // breakpoint on :root (`@theme static`).
    const lg = getComputedStyle(document.documentElement)
      .getPropertyValue("--tw-breakpoint-lg")
      .trim();
    matchMedia(`(width >= ${lg})`).addEventListener("change", (event) => {
      if (event.matches && isOpen()) setOpen(false);
    });

    // A back/forward cache restore keeps the DOM as it was; start closed.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted && isOpen()) setOpen(false);
    });
  }
</script>
