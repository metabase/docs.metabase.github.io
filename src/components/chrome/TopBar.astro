---
import Breadcrumb from "@/components/chrome/Breadcrumb.astro";
import VersionSelector from "@/components/chrome/VersionSelector.astro";
import InkeepSearch from "@/components/InkeepSearch/InkeepSearch.astro";
import { TOP_BAR_ID } from "@/constants";
import Stars from "@/icons/stars.svg";

interface Props {
  page: {
    version?: string;
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
  showBreadcrumb: boolean;
}

const { page, showBreadcrumb } = Astro.props;
---

<div id={TOP_BAR_ID} class="top-bar">
  <div>
    <button
      class="d-lg-none docs-nav-toggle"
      type="button"
      data-toggle="main-navigation-content"
      aria-controls="main-navigation-content"
      aria-expanded="false"
      aria-label="Open docs navigation"
    >
      <svg
        width="18"
        height="9"
        viewBox="0 0 18 9"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1 1.5h16M1 7.5h10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </button>
    {showBreadcrumb && (
      <div class="learn-breadcrumb-trail">
        <Breadcrumb page={page} />
      </div>
    )}
  </div>

  <div>
    <VersionSelector version={page.version} />
    <a href="/releases" class="whats-new">
      <Stars />
      What’s new
    </a>
    <InkeepSearch />
  </div>
</div>

<style>
  .docs-nav-toggle {
    appearance: none;
    background-color: transparent;
    border: 0;
    color: #5a6072;
    display: flex;
    flex-shrink: 0;
    margin-left: -11px;
    padding: 8px;
    transition: color 0.3s ease;

    &:hover {
      color: #509ee3;
    }
  }
</style>
