---
import Breadcrumb from "@/components/chrome/Breadcrumb.astro";
import DocsNavToggle from "@/components/chrome/DocsNavToggle.astro";
import TocToggle from "@/components/chrome/TocToggle.astro";
import VersionSelector from "@/components/chrome/VersionSelector.astro";
import InkeepSearch from "@/components/InkeepSearch/InkeepSearch.astro";
import { TOP_BAR_ID } from "@/constants";
import Stars from "@/icons/stars.svg";

interface Props {
  page: {
    version?: string;
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
  showBreadcrumb: boolean;
  showNavToggle: boolean;
}

const { page, showBreadcrumb, showNavToggle } = Astro.props;
---

<div id={TOP_BAR_ID}>
  <div class="container">
    <div>
      {showNavToggle && <DocsNavToggle />}
      {showBreadcrumb && <Breadcrumb page={page} variant="bar" />}
    </div>

    <div>
      <VersionSelector version={page.version} />
      <a href="/releases" class="whats-new">
        <Stars />
        What’s new
      </a>
      <TocToggle />
      <InkeepSearch />
    </div>
  </div>
</div>

<style>
  /* The id outranks every `.bootstrap .learn …` rule in the legacy sheet, so nothing here needs doubling. */
  #top-bar {
    align-items: center;
    border-bottom: 1px solid #e4ecfb;
    display: flex;
    height: 57px;
    justify-content: space-between;
    left: 0;
    padding: 8px 0 8px 8px;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 3;

    :global(div) {
      align-items: center;
      display: flex;
      gap: 12px;
      z-index: 2;
    }

    > .container {
      display: contents;
    }
  }

  .whats-new {
    align-items: center;
    background-color: #eef6fc;
    border: 1px solid #e4ecfb;
    border-radius: 6px;
    display: none;
    font-size: 14px;
    gap: 5px;
    padding: 10px 16px 11px 13px;
    transition: background-color 0.3s ease;

    &:hover {
      background-color: #e4ecfb;
      color: #509ee3;
    }

    svg {
      zoom: 0.7;
    }

    @media (min-width: 1200px) {
      display: flex;
    }
  }

  /* On phones the bar is fixed under the site header and shares its bootstrap `.container` width steps. */
  @media (max-width: 991.98px) {
    #top-bar {
      background-color: #fff;
      border: 0;
      height: 40px;
      padding: 0;
      position: fixed;
      right: 0;
      top: var(--section-bar-top);
      transition: top 0.2s ease;
      width: auto;
      z-index: 5;

      /* 12px plus each control's 8px tap padding puts the glyphs on the header's 20px gutter. */
      > .container {
        display: flex;
        gap: 8px;
        height: 100%;
        padding: 0 12px;
      }

      > .container > div {
        display: contents;
      }

      :global(.version__selector) {
        display: none;
      }

      :global(.docs-nav-toggle),
      :global(.toc-toggle) {
        padding: 8px;
      }

      :global(.toc-toggle) {
        margin-left: auto;
        order: 1;
      }
    }
  }
</style>
