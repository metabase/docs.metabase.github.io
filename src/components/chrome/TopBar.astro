---
import Breadcrumb from "@/components/chrome/Breadcrumb.astro";
import DocsNavToggle from "@/components/chrome/DocsNavToggle.astro";
import VersionSelector from "@/components/chrome/VersionSelector.astro";
import InkeepSearch from "@/components/InkeepSearch/InkeepSearch.astro";
import { TOP_BAR_ID } from "@/constants";
import Stars from "@/icons/stars.svg";

interface Props {
  page: {
    version?: string;
    url: string;
    title?: string;
    category?: string;
    has_magic_breadcrumbs?: boolean;
    show_category_breadcrumb?: boolean;
  };
  showBreadcrumb: boolean;
  showVersionSelector: boolean;
}

const { page, showBreadcrumb, showVersionSelector } = Astro.props;
---

<div id={TOP_BAR_ID} class="top-bar">
  <div>
    <DocsNavToggle />
    {showBreadcrumb && (
      <div class="learn-breadcrumb-trail">
        <Breadcrumb page={page} />
      </div>
    )}
  </div>

  <div>
    {showVersionSelector && <VersionSelector version={page.version} />}
    <a href="/releases" class="whats-new">
      <Stars />
      What’s new
    </a>
    <InkeepSearch />
  </div>
</div>

<style is:global>
  .bootstrap .learn .top-bar a.whats-new {
    display: none!important;
  }
  @media (min-width: 992.02px) {
    .bootstrap .learn .top-bar a.whats-new {
      display: inline-flex!important;
    }
  }
</style>
