      {!hideMenu && (
        <div
          class="col-xs-12 d-flex d-none d-lg-none flex-column bg-neutral-white p-0"
          id="nav-menu-mobile"
        >
          <input
            autocomplete="off"
            class="nav-button-input"
            id="product-nav-button-mobile"
            type="checkbox"
          />
