                href="https://github.com/metabase/metabase"
                target="_blank"
                rel="noopener"
                aria-label="Metabase on GitHub"
              >
                <StarOutline />
                <span class="github-stars">{githubStars}</span>
                <Github />
              </a>
            )}
            {!hideMenu && (
              <a
                class="fs-13 d-none d-lg-block Button btn btn-transparent px-3 py-2"
                href="/cloud/login"
              >
                Log in
              </a>
