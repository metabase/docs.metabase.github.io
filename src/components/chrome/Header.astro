<script>
  const OPEN_CLASS = "open";

  function setOpen(button: HTMLElement, open: boolean) {
    button.classList.toggle(OPEN_CLASS, open);
    button.setAttribute("aria-expanded", String(open));
  }

  function initNavbar(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>("[data-navbar]").forEach((navbar) => {
      if (navbar.dataset.initialized === "true") return;
      navbar.dataset.initialized = "true";

      const desktopButtons = [
        ...navbar.querySelectorAll<HTMLElement>(".button-desktop"),
      ];
      desktopButtons.forEach((button) => {
        button.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            const open = !button.classList.contains(OPEN_CLASS);
            desktopButtons.forEach((item) =>
              setOpen(item, item === button && open),
            );
          }
          if (event.key === "Escape") setOpen(button, false);
        });
      });

      const hamburger = navbar.querySelector<HTMLElement>(
        "#mobile-nav-hamburger-wrapper",
      );
      const mobileMenu = navbar.querySelector<HTMLElement>("#nav-menu-mobile");
      const resizeMobileMenu = () => {
        if (mobileMenu)
          mobileMenu.style.height = `${window.innerHeight - 72}px`;
      };

      hamburger?.addEventListener("click", () => {
        const open = !hamburger.classList.contains(OPEN_CLASS);
        hamburger.classList.toggle(OPEN_CLASS, open);
        hamburger.setAttribute("aria-expanded", String(open));
        mobileMenu?.classList.toggle("d-none", !open);
        if (open) resizeMobileMenu();
      });

      window.addEventListener("resize", resizeMobileMenu);
      resizeMobileMenu();

      const highlight = navbar.querySelector<HTMLElement>("#hover-highlight");
      if (highlight) {
        window.setTimeout(() => highlight.classList.remove("hidden"), 200);
        desktopButtons.forEach((button) =>
          button.addEventListener("mouseenter", () => {
            highlight.style.left = `${button.offsetLeft}px`;
            highlight.style.width = `${button.offsetWidth}px`;
            highlight.style.height = `${button.offsetHeight}px`;
          }),
        );
      }

      if (
        new URLSearchParams(window.location.search).get("hide_nav") === "true"
      ) {
        navbar
          .closest<HTMLElement>("header.bootstrap")
          ?.setAttribute("hidden", "");
      }
    });
  }

  initNavbar();
</script>

