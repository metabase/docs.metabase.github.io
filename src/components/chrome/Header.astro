            for="features-nav-button-mobile"
          >
            <span class="h4 m-0">Features</span>
            <Chevron />
          </label>
          <div id="features-dropdown-mobile">
            {mobileFeatures.map((link) => (
              <NavLink {...link} />
            ))}
            <span class="menu-heading mobile">Updates</span>
            <NavLink title="What’s new" href="/releases" icon={Stars} />
            <NavLink title="Roadmap" href="/roadmap" icon={MapIcon} />
          </div>
          <input
            autocomplete="off"
            class="nav-button-input"
            id="docs-nav-button-mobile"
            type="checkbox"
          />
          <label
