---
import Balloon from "@/icons/chrome/balloon-rounded.svg";
import Book from "@/icons/chrome/book.svg";
import Box from "@/icons/chrome/box.svg";
import CloudOrSelfHosted from "@/icons/chrome/cloud-or-self-hosted.svg";
import CloudOutline from "@/icons/chrome/cloud-outline.svg";
import CsvUpload from "@/icons/chrome/csv-upload.svg";
import DataSources from "@/icons/chrome/data-sources.svg";
import DataStudio from "@/icons/chrome/data-studio.svg";
import EmbeddedSdk from "@/icons/chrome/embedded-analytics-sdk.svg";
import Github from "@/icons/chrome/github-icon.svg";
import Administration from "@/icons/chrome/gridded-circles/administration.svg";
import Embedding from "@/icons/chrome/gridded-circles/embedding.svg";
import Querying from "@/icons/chrome/gridded-circles/querying.svg";
import Hamburger from "@/icons/chrome/hamburger.svg";
import Heart from "@/icons/chrome/heart.svg";
import InteractiveDashboards from "@/icons/chrome/interactive-dashboards.svg";
import Learn from "@/icons/chrome/learn.svg";
import MagnifyingGlass from "@/icons/chrome/magnifying-glass.svg";
import Chevron from "@/icons/chrome/main-nav-chevron.svg";
import MapIcon from "@/icons/chrome/map.svg";
import MetabaseSymbol from "@/icons/chrome/metabase-symbol.svg";
import Metabot from "@/icons/chrome/metabot-icon.svg";
import Model from "@/icons/chrome/model.svg";
import Person from "@/icons/chrome/person-in-circle.svg";
import Play from "@/icons/chrome/play-outline-boxed.svg";
import PlayOutline from "@/icons/chrome/play-outline.svg";
import Ribbon from "@/icons/chrome/ribbon.svg";
import Rows from "@/icons/chrome/rows.svg";
import Sandbox from "@/icons/chrome/sandbox.svg";
import SecureShieldOutline from "@/icons/chrome/secure-shield-outline.svg";
import StarOutline from "@/icons/chrome/star-outline.svg";
import Stars from "@/icons/chrome/stars.svg";
import Support from "@/icons/chrome/support-bubble.svg";
import UsageAnalytics from "@/icons/chrome/usage-analytics.svg";
import View from "@/icons/chrome/view.svg";
import WhiteLabel from "@/icons/chrome/white-label.svg";
import { formatGithubStars, getGithubStars } from "@/lib/github/getGithubStars";
import NavLink, { type Props as NavLinkProps } from "./NavLink.astro";

export interface Props {
  hideMenu?: boolean;
  scrollable?: boolean;
  checkoutHref?: string;
  includeGithubStars?: boolean;
}

const {
  hideMenu = false,
  scrollable = false,
  checkoutHref = "https://store.metabase.com/checkout",
  includeGithubStars,
} = Astro.props;

const showPromoBanner = false;
const githubStars =
  includeGithubStars && formatGithubStars(await getGithubStars());

const featureColumns: NavLinkProps[][] = [
  [
    { title: "Metabase AI", href: "/features/metabase-ai", icon: Metabot },
    {
      title: "Data Studio",
      href: "/product/data-studio",
      icon: DataStudio,
      badge: "New",
    },
    {
      title: "Dashboards and reporting",
      href: "/features/analytics-dashboards",
      icon: InteractiveDashboards,
    },
    {
      title: "Query builder",
      href: "/features/query-builder",
      icon: CloudOrSelfHosted,
    },
    {
      title: "Data segregation",
      href: "/features/data-segregation",
      icon: Sandbox,
    },
    {
      title: "Usage analytics",
      href: "/features/usage-analytics",
      icon: UsageAnalytics,
    },
  ],
  [
    {
      title: "Embedded analytics SDK",
      href: "/product/embedded-analytics-sdk",
      icon: EmbeddedSdk,
    },
    {
      title: "White-label analytics",
      href: "/features/white-label-analytics",
      icon: WhiteLabel,
    },
    {
      title: "Drill-through",
      href: "/features/drill-through",
      icon: MagnifyingGlass,
    },
    { title: "SQL editor", href: "/features/sql-editor", icon: Rows },
    { title: "Permissions", href: "/features/permissions", icon: View },
    { title: "CSV upload", href: "/product/csv-uploads", icon: CsvUpload },
  ],
];

const mobileFeatures: NavLinkProps[] = [
  ...featureColumns.flat(),
  { title: "Semantic layer", href: "/features/semantic-layer", icon: Model },
];

const resourceLinks: NavLinkProps[] = [
  {
    title: "Blog",
    description: "News, updates, and ideas",
    href: "/blog",
    icon: Ribbon,
  },
  {
    title: "Events",
    description: "Join a live event or watch on demand",
    href: "/events",
    icon: Play,
  },
  {
    title: "Customers",
    description: "Real companies, real data, real stories",
    href: "/case-studies",
    icon: Heart,
  },
  {
    title: "Discussion",
    description: "Share and connect with other users",
    href: "https://discourse.metabase.com/",
    icon: Balloon,
  },
  {
    title: "Professional Services",
    description: "Extra help from our team",
    href: "/product/professional-services",
    icon: Person,
  },
  {
    title: "Metabase Experts",
    description: "Find a local expert",
    href: "/partners/",
    icon: Support,
  },
];
---

<div class="legacy-scope">
  <header
    class:list={[
      "bootstrap",
      scrollable ? "scrollable" : "sticky",
      !showPromoBanner && "promo-banner-hidden",
    ]}
  >
    <div
      class:list={[
        "navigation-header bg-neutral-white",
        !showPromoBanner && "promo-banner-hidden",
      ]}
      data-navbar
    >
      <div class="container">
        <div class="row flex-grow-1 flex-nowrap">
          <div
            class:list={[
              "home-link col-xs-4 d-flex align-items-center",
              hideMenu ? "col-lg-6" : "col-lg-2",
            ]}
          >
            <a
              href="/"
              aria-label="Metabase home"
              class="d-flex align-items-center"
            >
              <MetabaseSymbol />
              <span class="home-link-wordmark">Metabase</span>
            </a>
          </div>

          {!hideMenu && (
            <div class="submenus-container">
              <div class="hidden" id="hover-highlight" />

              <div
                class="Button btn btn-transparent button-desktop px-3 py-2"
                id="product-nav-button-desktop"
                tabindex="0"
                role="button"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <div class="fs-13 d-flex align-items-center">
                  Product <Chevron />
                </div>
                <div class="fw-normal text-start" id="product-nav-menu-wrapper">
                  <div class="nav-menu overflow-hidden">
                    <div class="button-style-link-container">
                      <a
                        href="/product/business-intelligence"
                        id="graph-bars-container"
                      >
                        <div>
                          <div id="graph-bars">
                            {Array.from({ length: 6 }, () => (
                              <div />
                            ))}
