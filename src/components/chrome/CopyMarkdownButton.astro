---
import { docAction } from "@/components/chrome/docs-ui";
import Check from "@/icons/check.svg";
import Copy from "@/icons/copy.svg";

// Copies the page's Markdown version (`src/pages/docs/[version]/[...slug].md.ts`)
// to the clipboard. Same icons as the code block copy button
// (new-docs-code-snippet-copy.js). An item in the AI tools row
// (DocActions.astro).
type Props = {
  /** URL of the page's Markdown version. */
  href: string;
};

const { href } = Astro.props;
---

<button
  type="button"
  class:list={[docAction, "tw:group tw:data-[state=copied]:text-brand"]}
  data-copy-markdown={href}
>
  <Copy
    class="tw:size-4 tw:group-data-[state=copied]:hidden"
    aria-hidden="true"
  />
  <Check
    class="tw:hidden tw:size-4 tw:group-data-[state=copied]:block"
    aria-hidden="true"
  />
  <span data-copy-markdown-label aria-live="polite">
    Copy as Markdown
  </span>
</button>

<script>
  const RESET_DELAY_MS = 2000;

  const button = document.querySelector<HTMLButtonElement>(
    "[data-copy-markdown]",
  )!;
  const label = button.querySelector("[data-copy-markdown-label]")!;
  const idleLabel = label.textContent;
  let resetTimer: ReturnType<typeof setTimeout> | undefined;

  // Safari only allows a clipboard write while the click is being handled,
  // and awaiting the fetch first would outlive that. A ClipboardItem takes
  // the pending fetch instead, so the write itself starts inside the click.
  const copyMarkdown = (url: string) =>
    navigator.clipboard.write([
      new ClipboardItem({
        "text/plain": fetch(url).then(async (response) => {
          if (!response.ok) throw new Error(`${response.status} for ${url}`);
          return new Blob([await response.text()], { type: "text/plain" });
        }),
      }),
    ]);

  button.addEventListener("click", async () => {
    const copied = await copyMarkdown(button.dataset.copyMarkdown!).then(
      () => true,
      () => false,
    );

    button.dataset.state = copied ? "copied" : "error";
    label.textContent = copied ? "Copied" : "Couldn’t copy";

    if (copied) {
      // The tracker only exists once marketing cookies are accepted.
      window.snowplow?.(
        "trackStructEvent",
        "docs-copy-markdown",
        "copy",
        location.pathname,
      );
    }

    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      delete button.dataset.state;
      label.textContent = idleLabel;
    }, RESET_DELAY_MS);
  });
</script>
