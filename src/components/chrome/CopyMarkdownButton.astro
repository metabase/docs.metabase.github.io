---
import Check from "@/icons/check.svg";
import Copy from "@/icons/copy.svg";

// Copies the page's Markdown version (`src/pages/docs/[version]/[...slug].md.ts`)
// to the clipboard. Same icons as the code block copy button
// (new-docs-code-snippet-copy.js).
type Props = {
  /** URL of the page's Markdown version. */
  href: string;
};

const { href } = Astro.props;
---

{/* The icon stands alone: the label is there for screen readers, and shows
    only when a copy fails, which the icon has no way to say. */}
<button
  type="button"
  class="tw:group tw:flex tw:shrink-0 tw:cursor-pointer tw:items-center tw:gap-1.5 tw:rounded-lg tw:border-0 tw:bg-transparent tw:p-1.5 tw:font-sans tw:text-sm/5 tw:font-bold tw:whitespace-nowrap tw:text-muted tw:transition-colors tw:hover:bg-surface-active tw:hover:text-brand tw:focus-ring tw:data-[state=copied]:text-brand"
  title="Copy Markdown"
  data-copy-markdown={href}
>
  <Copy
    class="tw:size-5 tw:group-data-[state=copied]:hidden"
    aria-hidden="true"
  />
  <Check
    class="tw:hidden tw:size-5 tw:group-data-[state=copied]:block"
    aria-hidden="true"
  />
  <span
    class="tw:sr-only tw:group-data-[state=error]:not-sr-only"
    data-copy-markdown-label
    aria-live="polite"
  >
    Copy Markdown
  </span>
</button>

<script>
  const RESET_DELAY_MS = 2000;

  const button = document.querySelector<HTMLButtonElement>(
    "[data-copy-markdown]",
  )!;
  const label = button.querySelector("[data-copy-markdown-label]")!;
  const idleLabel = label.textContent;
  let resetTimer: ReturnType<typeof setTimeout> | undefined;

  const fetchMarkdown = async (url: string) => {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`${response.status} for ${url}`);
    return response.text();
  };

  const copyMarkdown = async (url: string) => {
    const markdown = fetchMarkdown(url);
    // Safari only allows a clipboard write while the click is being handled,
    // and awaiting the fetch first would outlive that. A ClipboardItem takes
    // the pending fetch instead, so the write itself starts inside the click.
    if (typeof ClipboardItem !== "undefined") {
      const blob = markdown.then(
        (text) => new Blob([text], { type: "text/plain" }),
      );
      await navigator.clipboard.write([
        new ClipboardItem({ "text/plain": blob }),
      ]);
    } else {
      await navigator.clipboard.writeText(await markdown);
    }
  };

  button.addEventListener("click", async () => {
    let state = "copied";
    try {
      await copyMarkdown(button.dataset.copyMarkdown!);
    } catch {
      state = "error";
    }

    button.dataset.state = state;
    label.textContent = state === "copied" ? "Copied" : "Couldn’t copy";

    if (state === "copied") {
      // The tracker only exists once marketing cookies are accepted.
      window.snowplow?.(
        "trackStructEvent",
        "docs-copy-markdown",
        "copy",
        location.pathname,
      );
    }

    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      delete button.dataset.state;
      label.textContent = idleLabel;
    }, RESET_DELAY_MS);
  });
</script>
