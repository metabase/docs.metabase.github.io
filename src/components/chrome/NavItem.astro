---
import NavItem from "@/components/chrome/NavItem.astro";
import Chevron from "@/icons/chevron.svg";
import { containsUrl, type NavNode } from "@/lib/docs/nav";

type Props = {
  node: NavNode;
  pageUrl: string;
  /** Top-level item: a heading over its pages, always open, no chevron. */
  topic?: boolean;
};

const { node, pageUrl, topic = false } = Astro.props;

const hasChildren = Boolean(node.pages && node.pages.length > 0);
const expanded = hasChildren && (topic || containsUrl(node, pageUrl));
---

<li class:list={{ expanded, "docs-nav-topic": topic }}>
  <a href={node.url} class={pageUrl === node.url ? "selected" : ""}>
    {node.name}

    {hasChildren && !topic && (
      <div>
        <Chevron />
      </div>
    )}
  </a>

  {hasChildren && (
    <ul>
      {node.pages!.map((child) => (
        <NavItem node={child} pageUrl={pageUrl} />
      ))}
    </ul>
  )}
</li>
