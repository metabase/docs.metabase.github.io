---
import NavItem from "@/components/chrome/NavItem.astro";
import Chevron from "@/icons/chevron.svg";
import { containsUrl, type NavNode } from "@/lib/docs/nav";

type Props = {
  node: NavNode;
  pageUrl: string;
};

const { node, pageUrl } = Astro.props;

const hasChildren = Boolean(node.pages && node.pages.length > 0);
const expanded = containsUrl(node, pageUrl);
const isCurrent = pageUrl === node.url;
const selected = isCurrent ? "selected" : "";
---

<li class={expanded ? "expanded" : ""}>
  {hasChildren ? (
    <button
      type="button"
      class={selected}
      aria-expanded={expanded}
    >
      {node.name}
      <Chevron />
    </button>
  ) : (
    <a href={node.url} class={selected} aria-current={isCurrent ? "page" : undefined}>
      {node.name}
    </a>
  )}

  {hasChildren && (
    <ul>
      {node.pages!.map((child) => (
        <NavItem node={child} pageUrl={pageUrl} />
      ))}
    </ul>
  )}
</li>
