---
import NavItem from "@/components/chrome/NavItem.astro";
import Chevron from "@/icons/chevron.svg";
import { containsUrl, type NavNode } from "@/lib/docs/nav";
import { navLink } from "./docs-ui";

// A collapsible group's link goes to its page; the chevron beside it is a
// separate button that opens and closes the group (LeftSidebar.astro's
// script toggles `expanded` on the <li> and the button's aria-expanded, and
// closes the other open groups). A
// group without a page is one button. The `[li.expanded>…]` variants react
// to the class. A topic's own `expanded` is fixed at render time.
type Props = {
  node: NavNode;
  pageUrl: string;
  /**
   * 0 for a topic: a heading over its pages, always open, no chevron. Its
   * pages (depth 1) sit flush under it; the rail starts under collapsible
   * groups (depth 2+), 8px in so it lines up with the group's text.
   */
  depth: number;
  /** Unique in the sidebar; a group's page list is `${id}-pages`. */
  id: string;
};

const { node, pageUrl, depth, id } = Astro.props;

const topic = depth === 0;
const hasChildren = Boolean(node.pages && node.pages.length > 0);
const expanded = hasChildren && (topic || containsUrl(node, pageUrl));
const collapsible = hasChildren && !topic;
const current = pageUrl === node.url;
const listId = `${id}-pages`;
// A topic with no landing page is a label, not a link.
const label = topic && !node.url;

const row = [
  navLink,
  topic
    ? "tw:pr-2 tw:font-bold tw:text-heading"
    : "tw:pr-9.5 tw:font-normal tw:text-secondary",
  label ? "tw:cursor-default" : "tw:hover:bg-surface-hover tw:hover:text-brand",
];
// The 30px chevron target at the row's right edge.
const chevronBox =
  "tw:absolute tw:top-1/2 tw:right-0.5 tw:flex tw:size-7.5 tw:-translate-y-1/2 tw:items-center tw:justify-center";
const chevron = [
  "tw:h-3 tw:w-5 tw:-rotate-90 tw:group-hover/toggle:text-brand tw:group-aria-expanded/toggle:rotate-0 tw:motion-safe:transition-[rotate,color] tw:motion-safe:ease-in-out",
  current ? "tw:text-brand" : "tw:text-border-strong",
];
---

{/* Space above a topic with pages and after one; a run of page-less topics
    (Other resources) stays a tight list. */}
<li
  class:list={[
    "tw:m-0 tw:pb-1",
    { expanded },
    topic && "tw:[&.expanded:not(:first-child)]:mt-6 tw:[li.expanded+&]:mt-6",
    depth >= 2 && "tw:ml-2 tw:border-l tw:border-border tw:pl-2.5",
  ]}
>
  {collapsible && !node.url ? (
    <button
      type="button"
      class:list={[
        row,
        "tw:group/toggle tw:w-full tw:cursor-pointer tw:border-0 tw:bg-transparent tw:text-left tw:font-sans",
      ]}
      aria-expanded={expanded ? "true" : "false"}
      aria-controls={listId}
      data-nav-toggle
    >
      {node.name}
      <span class={chevronBox}>
        <Chevron class:list={chevron} />
      </span>
    </button>
  ) : (
    <div class="tw:relative">
      <a
        href={node.url}
        class:list={row}
        aria-current={current ? "page" : undefined}
      >
        {node.name}
      </a>
      {collapsible && (
        <button
          type="button"
          class:list={[
            chevronBox,
            "tw:group/toggle tw:cursor-pointer tw:rounded-md tw:border-0 tw:bg-transparent tw:p-0 tw:focus-ring tw:focus-visible:-outline-offset-2",
          ]}
          aria-label={`Pages in ${node.name}`}
          aria-expanded={expanded ? "true" : "false"}
          aria-controls={listId}
          data-nav-toggle
        >
          <Chevron class:list={chevron} />
        </button>
      )}
    </div>
  )}

  {hasChildren && (
    <ul
      id={listId}
      class="tw:hidden tw:list-none tw:p-0 tw:[li.expanded>&]:block"
    >
      {node.pages!.map((child, index) => (
        <NavItem
          node={child}
          pageUrl={pageUrl}
          depth={depth + 1}
          id={`${id}-${index}`}
        />
      ))}
    </ul>
  )}
</li>
