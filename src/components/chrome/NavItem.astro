---
import NavItem from "@/components/chrome/NavItem.astro";
import Chevron from "@/icons/chevron.svg";
import { containsUrl, type NavNode } from "@/lib/docs/nav";

type Props = {
  node: NavNode;
  pageUrl: string;
  depth?: number;
};

const { node, pageUrl, depth = 0 } = Astro.props;

const hasChildren = Boolean(node.pages && node.pages.length > 0);
// Top-level sections start open; deeper ones only when they contain the page.
const expanded = containsUrl(node, pageUrl) || (depth === 0 && hasChildren);
---

<li class={expanded ? "expanded" : ""}>
  <a href={node.url} class={pageUrl === node.url ? "selected" : ""}>
    {node.name}

    {hasChildren && (
      <div>
        <Chevron />
      </div>
    )}
  </a>

  {hasChildren && (
    <ul>
      {node.pages!.map((child) => (
        <NavItem node={child} pageUrl={pageUrl} depth={depth + 1} />
      ))}
    </ul>
  )}
</li>
