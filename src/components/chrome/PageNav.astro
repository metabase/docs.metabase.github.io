---
// "On this page" list of the article's h2s, filled in by the script below.
// Below lg the right sidebar is `display: contents` (NewDocsLayout), so
// the toggle and the list become an in-flow row above the article; -order-1
// puts them first. At phone widths the article's 20px right gutter lives on
// .learn__post__content, which this row is not inside, hence max-sm:mr-5.
---

<button
  id="toc-toggle"
  class="tw:-order-1 tw:flex tw:items-center tw:justify-between tw:border-0 tw:border-b tw:border-border tw:bg-transparent tw:px-0 tw:py-3 tw:font-sans tw:text-sm tw:font-bold tw:text-heading tw:after:transition-[rotate] tw:after:content-['▾'] tw:aria-expanded:after:rotate-180 tw:max-sm:mr-5 tw:lg:hidden"
  type="button"
  aria-controls="sub-navigation-content"
  aria-expanded="false"
>
  On this page
</button>
<div
  id="sub-navigation-content"
  class="tw:overflow-y-auto tw:pt-[3em] tw:max-lg:-order-1 tw:max-lg:hidden tw:max-lg:pt-3 tw:max-lg:data-open:block tw:max-sm:mr-5"
></div>

<script>
  const button = document.getElementById("toc-toggle")!;
  const content = document.getElementById("sub-navigation-content")!;

  button.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") !== "true";
    content.toggleAttribute("data-open", open);
    button.setAttribute("aria-expanded", String(open));
  });

  // The first link carries the "On this page" heading as a ::before, so the
  // heading only exists when there is something to list. Below lg the
  // toggle button is the heading instead.
  const linkClass =
    "tw:relative tw:mb-4 tw:block tw:pl-5 tw:text-sm tw:leading-[1.33] tw:font-normal tw:text-muted tw:no-underline tw:transition-none tw:first:before:block tw:first:before:pb-6 tw:first:before:font-bold tw:first:before:text-heading tw:first:before:content-['On_this_page'] tw:hover:text-secondary tw:data-active:text-secondary tw:max-lg:first:before:content-none";

  const headers = Array.from(document.querySelectorAll("h2"));
  const links = new Map<HTMLHeadingElement, HTMLAnchorElement>();
  let activeLink: HTMLAnchorElement | null = null;

  for (const header of headers) {
    const link = document.createElement("a");
    link.href = `#${header.id}`;
    link.innerText = header.innerText;
    link.className = linkClass;
    content.appendChild(link);
    links.set(header, link);
  }

  const setSelectedLink = () => {
    const header = headers.find((h) => h.getBoundingClientRect().top > 0);
    const link = header && links.get(header);
    if (!link || activeLink === link) return;
    activeLink?.removeAttribute("data-active");
    activeLink = link;
    activeLink.setAttribute("data-active", "");
  };

  document.addEventListener("scroll", setSelectedLink);
  setSelectedLink();
</script>
