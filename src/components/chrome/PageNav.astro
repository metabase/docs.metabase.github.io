<nav id="sub-navigation-content" aria-label="On this page">
  <button type="button" class="return-to-top" data-return-to-top>
    Return to top
  </button>
</nav>

<script>
  const content = document.getElementById("sub-navigation-content")!;
  // The phone toggle lives in the section bar, outside the rail.
  const toggle = document.querySelector<HTMLElement>("[data-toc-toggle]");
  const markOverflow = () =>
    content.classList.toggle(
      "overflowing",
      content.scrollTop + content.clientHeight < content.scrollHeight - 1,
    );
  const setOpen = (open: boolean) => {
    content.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    if (open) markOverflow();
  };

  content.addEventListener("scroll", markOverflow, { passive: true });

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  // Links close the dropdown as they navigate; so does any click outside it.
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (toggle?.contains(target)) return;
    if (!content.contains(target) || target.closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
  content
    .querySelector<HTMLElement>("[data-return-to-top]")
    ?.addEventListener("click", () => {
      window.scrollTo(0, 0);
      setOpen(false);
    });

  const headers = Array.from(document.querySelectorAll("h2"));
  const links = new Map<HTMLHeadingElement, HTMLAnchorElement>();
  let activeLink: HTMLAnchorElement | null = null;

  if (headers.length === 0) toggle?.setAttribute("hidden", "");

  for (const header of headers) {
    const link = document.createElement("a");
    link.href = `#${header.id}`;
    link.innerText = header.innerText;
    content.appendChild(link);
    links.set(header, link);
  }

  const setSelectedLink = () => {
    const header = headers.find((h) => h.getBoundingClientRect().top > 0);
    const link = header && links.get(header);
    if (!link || activeLink === link) return;
    activeLink?.classList.remove("selected");
    activeLink = link;
    activeLink.classList.add("selected");
  };

  document.addEventListener("scroll", setSelectedLink);
  setSelectedLink();
</script>

<style is:global>
  #sub-navigation-content {
    overflow-y: auto;
    padding-top: 3em;

    &::before {
      color: #22242b;
      content: "On this page";
      display: block;
      font-size: 14px;
      font-weight: 700;
      padding: 0 0 1.5rem 20px;
    }

    .return-to-top {
      display: none;
    }

    a {
      background: transparent;
      box-shadow: none;
      color: #8d93a5;
      display: block;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.33;
      margin-bottom: 1rem;
      padding-bottom: 0;
      padding-left: 20px;
      position: relative;
      transition: initial;

      &::after {
        content: none;
      }

      &:hover,
      &.selected {
        color: #5a6072;
      }
    }
  }

  /* Below lg the rail dissolves; the list becomes a dropdown hanging off the section bar. */
  @media (max-width: 991.98px) {
    #sub-navigation-content {
      background-color: #fff;
      border: 1px solid #eeecec;
      border-radius: 8px;
      box-shadow: 0 12px 32px rgba(34, 36, 43, 0.16);
      left: 16px;
      max-height: min(60dvh, calc(100dvh - var(--section-bar-top, 0px) - 72px));
      opacity: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 6px 8px 0;
      position: fixed;
      right: 16px;
      top: calc(var(--section-bar-top, 0px) + 48px);
      transition:
        opacity 0.2s ease,
        top 0.2s ease,
        translate 0.2s ease,
        visibility 0s 0.2s;
      translate: 0 -8px;
      visibility: hidden;
      z-index: 6;

      &.open {
        opacity: 1;
        transition:
          opacity 0.2s ease,
          top 0.2s ease,
          translate 0.2s ease;
        translate: 0;
        visibility: visible;
      }

      &::before {
        display: none;
      }

      /* Sticky so it rides the scrollport's bottom edge; JS hides it once the end is in view. */
      &::after {
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff);
        bottom: 0;
        content: "";
        display: block;
        height: 40px;
        margin-top: -40px;
        opacity: 0;
        pointer-events: none;
        position: sticky;
        transition: opacity 0.2s ease;
      }

      &.overflowing::after {
        opacity: 1;
      }

      .return-to-top {
        appearance: none;
        background-color: transparent;
        border: 0;
        border-bottom: 1px solid #eeecec;
        border-radius: 0;
        color: #509ee3;
        display: block;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.33;
        margin-bottom: 4px;
        padding: 8px 8px 10px;
        text-align: left;
        width: 100%;
      }

      a {
        border-radius: 8px;
        color: #5a6072;
        font-size: 15px;
        margin-bottom: 0;
        padding: 6px 8px;

        &:last-of-type {
          margin-bottom: 6px;
        }

        &.selected {
          background-color: #eef6fc;
          color: #509ee3;
          font-weight: 700;
        }
      }
    }
  }
</style>
