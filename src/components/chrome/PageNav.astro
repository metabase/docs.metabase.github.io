<nav id="sub-navigation-content" aria-label="On this page"></nav>

<script>
  const content = document.getElementById("sub-navigation-content")!;
  // The phone toggle lives in the section bar, outside the rail.
  const toggle = document.querySelector<HTMLElement>("[data-toc-toggle]");
  const setOpen = (open: boolean) => {
    content.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  // Links close the sheet as they navigate; so does any click outside it.
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (toggle?.contains(target)) return;
    if (!content.contains(target) || target.closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });

  const headers = Array.from(document.querySelectorAll("h2"));
  const links = new Map<HTMLHeadingElement, HTMLAnchorElement>();
  let activeLink: HTMLAnchorElement | null = null;

  if (headers.length === 0) toggle?.setAttribute("hidden", "");

  for (const header of headers) {
    const link = document.createElement("a");
    link.href = `#${header.id}`;
    link.innerText = header.innerText;
    content.appendChild(link);
    links.set(header, link);
  }

  const setSelectedLink = () => {
    const header = headers.find((h) => h.getBoundingClientRect().top > 0);
    const link = header && links.get(header);
    if (!link || activeLink === link) return;
    activeLink?.classList.remove("selected");
    activeLink = link;
    activeLink.classList.add("selected");
  };

  document.addEventListener("scroll", setSelectedLink);
  setSelectedLink();
</script>

<style is:global>
  #sub-navigation-content {
    overflow-y: auto;
    padding-top: 3em;

    &::before {
      color: #22242b;
      content: "On this page";
      display: block;
      font-size: 14px;
      font-weight: 700;
      padding: 0 0 1.5rem 20px;
    }

    a {
      background: transparent;
      box-shadow: none;
      color: #8d93a5;
      display: block;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.33;
      margin-bottom: 1rem;
      padding-bottom: 0;
      padding-left: 20px;
      position: relative;
      transition: initial;

      &::after {
        content: none;
      }

      &:hover,
      &.selected {
        color: #5a6072;
      }
    }
  }

  /* Below lg the rail dissolves; the list becomes a bottom sheet. The backdrop is a
     spread shadow: a pseudo-element would paint over the sheet's own background. */
  @media (max-width: 991.98px) {
    #sub-navigation-content {
      background-color: #fff;
      border-radius: 16px 16px 0 0;
      bottom: -100vh;
      box-shadow: 0 0 0 100vmax rgba(34, 36, 43, 0.35);
      left: 0;
      max-height: 70dvh;
      overflow-y: auto;
      padding: 24px 20px calc(16px + env(safe-area-inset-bottom));
      position: fixed;
      right: 0;
      transition:
        bottom 0.2s ease,
        visibility 0s 0.2s;
      visibility: hidden;
      z-index: 10001;

      &.open {
        bottom: 0;
        transition: bottom 0.2s ease;
        visibility: visible;
      }

      &::before {
        font-size: 15px;
        padding: 0 8px 12px;
      }

      a {
        border-radius: 8px;
        color: #5a6072;
        font-size: 15px;
        margin-bottom: 0;
        padding: 10px 8px;

        &.selected {
          background-color: #eef6fc;
          color: #509ee3;
          font-weight: 700;
        }
      }
    }
  }
</style>
