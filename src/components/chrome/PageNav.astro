<nav id="sub-navigation-content" aria-label="On this page"></nav>

<script>
  import {
    appendHeadingLinks,
    currentHeading,
    pageHeadings,
  } from "@/lib/page-toc";

  const content = document.getElementById("sub-navigation-content")!;
  const headers = pageHeadings();
  const links = appendHeadingLinks(content, headers);
  let activeLink: HTMLAnchorElement | null = null;

  const setSelectedLink = () => {
    const header = currentHeading(headers);
    const link = header && links.get(header);
    if (!link || activeLink === link) return;
    activeLink?.classList.remove("selected");
    activeLink = link;
    activeLink.classList.add("selected");
  };

  document.addEventListener("scroll", setSelectedLink);
  setSelectedLink();
</script>

<style is:global>
  #sub-navigation-content {
    overflow-y: auto;
    padding-top: 3em;

    &:has(a)::before {
      color: #22242b;
      content: "On this page";
      display: block;
      font-size: 14px;
      font-weight: 700;
      padding: 0 0 1.5rem 20px;
    }

    a {
      background: transparent;
      box-shadow: none;
      color: #8d93a5;
      display: block;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.33;
      margin-bottom: 1rem;
      padding-bottom: 0;
      padding-left: 20px;
      position: relative;
      transition: initial;

      &::after {
        content: none;
      }

      &:hover,
      &.selected {
        color: #5a6072;
      }
    }
  }
</style>
