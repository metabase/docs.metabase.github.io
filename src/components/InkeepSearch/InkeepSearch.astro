---
// Buttons marked `data-inkeep-search` open the widget in the visitor's
// preferred view; `data-inkeep-ask-ai` opens it straight into chat.
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div id="inkeep" class={className}></div>

<script>
  // cxkit-js declares sideEffects: false, so a bare static import gets tree-shaken.
  await import("@inkeep/cxkit-js");

  // cxkit-types doesn't declare setView; it is undefined until the component
  // has mounted.
  type View = "search" | "chat";
  type SearchBar = ReturnType<typeof window.Inkeep.SearchBar> & {
    setView?: (view: View) => void;
  };

  const VIEW_KEY = "mb-docs-search-view";

  const getStoredView = (): View => {
    try {
      return localStorage.getItem(VIEW_KEY) === "chat" ? "chat" : "search";
    } catch {
      return "search";
    }
  };

  // The view the visitor last picked with the Search/Ask toggle.
  let preferredView = getStoredView();

  let widget: SearchBar | undefined;
  const onOpenChange = (open: boolean) => {
    widget?.update({ modalSettings: { isOpen: open, onOpenChange } });
    // The widget keeps its last view across closes; without this, the search
    // bar would reopen on chat after "Ask AI" even for visitors who prefer
    // search.
    if (!open) widget?.setView?.(preferredView);
  };

  widget = window.Inkeep.SearchBar("#inkeep", {
    baseSettings: {
      apiKey: "6dd55673e83be3649d9ef8281b40795329b492a8fc320985",
      organizationDisplayName: "Metabase",
      primaryBrandColor: "#509EE3",
      theme: {
        styles: [{ type: "link", value: "/docs/css/inkeep.css" }],
      },
      colorMode: {
        sync: {
          target: document.documentElement,
          attributes: ["data-theme"],
          isDarkMode: (attributes) => attributes["data-theme"] === "dark",
        },
      },
    },
    aiChatSettings: {
      aiAssistantName: "Metabase",
      chatSubjectName: "Metabase",
      placeholder: "How long does it take to bake a pie chart?",
      introMessage:
        "Hi! You can ask me about Metabase. <em>(Please check the sources; I'm still learning.)</em>",
      prompts: ["Be succinct"],
      aiAssistantAvatar: {
        light: "/images/icons/metabase-icon.svg",
        dark: "/images/icons/metabase-icon.svg",
      },
      userAvatar: "/images/icons/person.svg",
    },
    searchSettings: {
      placeholder: "Search the docs or ask AI…",
    },
    shouldShowAskAICard: false,
    askAILabel: "Ask",
    defaultView: preferredView,
    // Fires for clicks on the toggle only, not for our own setView calls.
    onToggleView: ({ view }: { view: View }) => {
      preferredView = view;
      try {
        localStorage.setItem(VIEW_KEY, view);
      } catch {
        /* storage blocked; the choice lasts for this page only */
      }
    },
    modalSettings: {
      shortcutKey: "k",
      isOpen: false,
      onOpenChange,
    },
  });

  document.querySelectorAll("[data-inkeep-search]").forEach((button) => {
    button.addEventListener("click", () => onOpenChange(true));
  });

  document.querySelectorAll("[data-inkeep-ask-ai]").forEach((button) => {
    button.addEventListener("click", () => {
      onOpenChange(true);
      widget?.setView?.("chat");
    });
  });
</script>
