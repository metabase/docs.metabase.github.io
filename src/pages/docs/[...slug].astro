---
import { getCollection } from "astro:content";
import { renderJekyllPage } from "../../lib/jekyll-layouts";
import { renderDoc } from "../../lib/render-doc";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.flatMap((doc) => {
    // Honor Jekyll front-matter permalink overrides ("/docs/",
    // "/docs/v0.xx/index.html"); otherwise the URL is the file path,
    // matching Jekyll's `/:collection/:path` default.
    let slug = doc.data.permalink
      ? String(doc.data.permalink)
          .replace(/^\/docs\//, "")
          .replace(/\.html$/, "")
      : doc.id;
    // Trailing-slash permalinks are Jekyll directory indexes
    if (slug === "" || slug.endsWith("/")) slug += "index";
    // Only pass the id through, not the entry itself: renderDoc() (below)
    // reads the file fresh off disk on every request instead of relying on
    // a cached entry, so edits to a _docs file always show up without a
    // dev-server restart. See render-doc.ts for why.
    const paths = [{ params: { slug }, props: { id: doc.id } }];
    // Dev-only: the dev server routes by params (not files), so /docs/v0.58/
    // wouldn't match the "v0.58/index" slug that produces v0.58/index.html.
    // Register the directory URL as an alias; in builds a static host serves
    // index.html for directory requests, so no extra output is wanted.
    if (import.meta.env.DEV && (slug === "index" || slug.endsWith("/index"))) {
      paths.push({
        params: { slug: slug.slice(0, -"index".length).replace(/\/$/, "") || undefined },
        props: { id: doc.id },
      });
    }
    return paths;
  });
}

const { id } = Astro.props;
const { data, html: renderedHtml } = await renderDoc(id);

// Jekyll's page.url: the permalink verbatim when set, else the default
// collection URL (no extension).
const url = data.permalink ? String(data.permalink) : `/docs/${id}`;

const html = await renderJekyllPage(
  String(data.layout ?? "new-docs"),
  renderedHtml,
  // content: Jekyll exposes the converted page HTML to layouts/includes
  // (docs-metadata.html derives og:description from it).
  { ...data, url, content: renderedHtml }
);
---

<Fragment set:html={html} />
