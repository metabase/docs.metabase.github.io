---
import { getCollection } from "astro:content";
import { renderDoc } from "../../../lib/render-doc";
import NewDocsLayout from "../../../layouts/NewDocsLayout.astro";

export const getStaticPaths = async () => {
  const docsLatest = await getCollection("docsLatest");
  const docsPrevious = await getCollection("docsPrevious");
  return [
    ...docsLatest.map(function (doc: { id: string }) {
      if (doc.id === "embedding/eajs/snippets") {
        console.log(doc);
      }
      return {
        params: {
          slug: doc.id === "readme" ? undefined : doc.id,
          version: "latest",
        },
        props: { doc },
      };
    }),
    ...docsPrevious.map((doc: { id: string }) => {
      const [worktreeDir, slug] = doc.id.split("/docs/");
      const [, versionStr] = worktreeDir.match(/release-x(\d+)x/) as string[];
      return {
        params: {
          slug: slug === "readme" ? undefined : slug,
          version: `v0.${versionStr}`,
        },
        props: { doc },
      };
    }),
  ];
};

const { slug, version } = Astro.params;
const { doc } = Astro.props;

const { html: renderedHtml } = await renderDoc(doc);

const toTitleCase = (str: string) => {
  return str
    .toLowerCase()
    .split(" ")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};

function constructDocMetadata(path: string, version: string) {
  const metadata: Record<string, unknown> = {};
  metadata.version = version;
  metadata.has_magic_breadcrumbs = true;
  // We default to showing both category and title breadcrumbs, then toggle either a category and/or title breadcrumb in certain scenarios
  // For documentation TOC pages, we _only_ use the title in the breadcrumb
  // For _category_ TOC pages (one level below the root), we only use the category in the breadbrumb
  metadata.show_category_breadcrumb = true;
  metadata.show_title_breadcrumb = true;

  // Remove prefixes to docs directory, making all paths below relative
  const pathArray = path.split("/");
  pathArray.splice(0, 2);

  // #breadcrumb and title/category logic
  if (pathArray.length === 1) {
    metadata.show_category_breadcrumb = false;
    metadata.category = "Table of Contents";
    // metadata.title = formatDocTitle(pathArray[0]);
  } else {
    if (pathArray[0] === "faq") {
      metadata.category = "FAQ";
    } else {
      metadata.category = toTitleCase(pathArray[0]).replace(/-/g, " ");
    }
    // metadata.title = formatDocTitle(pathArray[pathArray.length - 1]);
  }

  // MOST categories use start.md, except for the troubleshooting guide :)
  if (pathArray.length > 1 && pathArray[1].match(/^(index|start)\.md$/))
    metadata.show_title_breadcrumb = false;

  return metadata;
}
const url = doc.data.permalink ? String(doc.data.permalink) : `/docs/${version}/${doc.id}`;
const page = {
  ...doc.data,
  url,
  ...constructDocMetadata(`/docs/${slug}`, version),
};
---

<NewDocsLayout page={page}>
  <Fragment set:html={renderedHtml} />
</NewDocsLayout>
