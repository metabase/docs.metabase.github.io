---
import { getCollection, getEntry } from "astro:content";
import { renderJekyllPage } from "../../../lib/jekyll-layouts";
import { renderDoc } from "../../../lib/render-doc";
import NewDocsLayout from "../../../layouts/NewDocsLayout.astro";

export const prerender = false;

const { version, slug } = Astro.params;

const { data, html: renderedHtml } = await renderDoc(version + "/" + slug!);

const page = {
  version: "v0.62",
  latest: true,
  category: "Getting Started",
  title: "Test Page",
  has_magic_breadcrumbs: true,
  show_category_breadcrumb: true,
  source_url: "https://github.com/metabase/metabase/blob/master/docs/README.md",
  permalink: "/docs/latest/getting-started/index.html",
  url: "/docs/latest/getting-started",
};

// const doc = await getEntry("docs", version + "/" + slug);
// console.log(doc);

// // Jekyll's page.url: the permalink verbatim when set, else the default
// // collection URL (no extension).
// const url = data.permalink ? String(data.permalink) : `/docs/${id}`;

// const html = await renderJekyllPage(
//   String(data.layout ?? "new-docs"),
//   renderedHtml,
//   // content: Jekyll exposes the converted page HTML to layouts/includes
//   // (docs-metadata.html derives og:description from it).
//   { ...data, url, content: renderedHtml }
// );
---

<NewDocsLayout page={page}>
  <Fragment set:html={renderedHtml} />
</NewDocsLayout>

