---
import path from "node:path";
import HtmlDoc from "@/components/docs/HtmlDoc.astro";
import MdDoc from "@/components/docs/MdDoc.astro";
import MdxDoc from "@/components/docs/MdxDoc.astro";
import { DOCS_SRC_ROOT, METABASE_REPO_PATH } from "@/constants";
import {
  constructDocMetadata,
  type DocPage,
} from "@/lib/docs/constructDocMetadata";
import { resolveDocUrl } from "@/lib/docs/resolveDoc";
import { baseCtx } from "@/lib/liquid/liquidRenderer";
import { getCollection, type DataEntryMap } from "astro:content";

type Props =
  | { kind: "md" | "mdx"; doc: DataEntryMap["docs"][number] }
  | { kind: "html"; doc: DataEntryMap["docsHtml"][number] };

export const getStaticPaths = async () => {
  const [docs, docsHtml] = await Promise.all([
    getCollection("docs"),
    getCollection("docsHtml"),
  ]);

  const toPath = (kind: Props["kind"], doc: Props["doc"]) => {
    const { version, slug } = resolveDocUrl({
      id: doc.id,
      // For prod builds, we want to output like folder/index.html, but for the dev server, the route should exclude /index
      includeTrailingIndex: import.meta.env.MODE !== "development",
    });
    return { props: { kind, doc }, params: { version, slug } };
  };

  return [
    ...docs.map((doc) =>
      toPath(doc.filePath!.endsWith(".mdx") ? "mdx" : "md", doc),
    ),
    ...docsHtml.map((doc) => toPath("html", doc)),
  ];
};

const { version } = Astro.params;
const { kind, doc } = Astro.props;
const latest = version === "latest";
const filePath = doc.filePath!;
const dirname = path.dirname(filePath);

const page: DocPage = {
  url: resolveDocUrl({ id: doc.id }).url,
  ...constructDocMetadata(
    METABASE_REPO_PATH
      ? `/${path.relative(METABASE_REPO_PATH, filePath)}`
      : `/docs/${path.relative(`${DOCS_SRC_ROOT}/${version}`, filePath)}`,
    latest ? baseCtx.site.docs_version : version!,
    latest,
  ),
  ...doc.data,
};
---

{kind === "html" ? (
  <HtmlDoc doc={doc} page={page} dirname={dirname} />
) : kind === "md" ? (
  <MdDoc doc={doc} page={page} dirname={dirname} />
) : kind === "mdx" ? (
  <MdxDoc doc={doc} page={page} dirname={dirname} />
) : null}
