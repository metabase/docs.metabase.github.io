---
import CategoryLayout from "@/layouts/CategoryLayout.astro";
import NewDocsLayout from "@/layouts/NewDocsLayout.astro";
import {
  isLegacyDoc,
  renderHtmlDoc,
  renderMarkdownDoc,
  toDocParams,
  type HtmlDoc,
  type MarkdownDoc,
} from "@/lib/docs/docPages";
import { hasMarkdownVersion, toMarkdownUrl } from "@/lib/docs/resolveDoc";
import { getCollection } from "astro:content";

// Doc pages in the themed layout (`layout: category` landing pages wrap it in
// CategoryLayout), and the standalone `.html` docs. Legacy `layout: docs`
// pages have their own route, [...legacySlug].astro; see
// src/lib/docs/docPages.ts for why. Keep OldDocsLayout out of this file.
type Props = { kind: "md"; doc: MarkdownDoc } | { kind: "html"; doc: HtmlDoc };

export const getStaticPaths = async () => {
  const [docs, docsHtml] = await Promise.all([
    getCollection("docs"),
    getCollection("docsHtml"),
  ]);

  return [
    ...docs.flatMap((doc) => {
      const params = toDocParams(doc.id);
      return isLegacyDoc(doc, params.version)
        ? []
        : [{ params, props: { kind: "md" as const, doc } }];
    }),
    ...docsHtml.map((doc) => ({
      params: toDocParams(doc.id),
      props: { kind: "html" as const, doc },
    })),
  ];
};

const { version } = Astro.params;
const { kind, doc } = Astro.props as Props;

// `.html` docs are complete standalone pages: no layout (renderHtmlDoc).
const html = kind === "html" ? await renderHtmlDoc(doc, version) : undefined;
const md = kind === "md" ? await renderMarkdownDoc(doc, version) : undefined;
---

{md ? (
  md.page.layout === "category" ? (
    <CategoryLayout page={md.page} dirname={md.dirname} />
  ) : (
    <NewDocsLayout
      page={md.page}
      dirname={md.dirname}
      summary={md.summary}
      markdownUrl={
        hasMarkdownVersion(version) ? toMarkdownUrl(md.page.url) : undefined
      }
    >
      <Fragment set:html={md.html} />
    </NewDocsLayout>
  )
) : (
  <Fragment set:html={html} />
)}
