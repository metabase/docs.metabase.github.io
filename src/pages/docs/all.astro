---
import path from "node:path";
import { fileURLToPath } from "node:url";
import NewDocsLayout from "@/layouts/NewDocsLayout.astro";
import { baseCtx } from "@/lib/liquid/liquidRenderer";

const { site } = baseCtx;

const page = {
  title: "Available Versions",
  url: Astro.url.pathname,
};

const dirname = path.dirname(fileURLToPath(import.meta.url));
---

<NewDocsLayout page={page} dirname={dirname}>
  <h1>Available docs versions</h1>

  <p>
    We version our docs for every major release, with docs for each major
    release covering each point release. E.g., docs for v0.XX cover v0.XX.1,
    v0.XX.2, and so on.
  </p>

  <p>
    For product releases, see the list of <a
      href="https://github.com/metabase/metabase/releases">Metabase releases</a
    >.
  </p>

  <p>
    Versions marked <span class="version__tag version__tag--unsupported"
      >unsupported</span
    > have passed their end-of-life date. See our <a href="/version-support"
      >version support policy</a
    > for details.
  </p>

  <ul>
    {
      [...site.available_versions].reverse().map((version: string) => {
        const support = site.data.version_support[version];
        return (
          <li>
            <p>
              <a href={`/docs/${version}/`}>
                {version}{" "}
                {support.status === "unsupported" ? (
                  <span class="version__tag version__tag--unsupported">
                    unsupported
                  </span>
                ) : support.lts ? (
                  <span class="version__tag version__tag--lts">lts</span>
                ) : null}
              </a>
            </p>
          </li>
        );
      })
    }
  </ul>
</NewDocsLayout>
