# Metabase EditorConfig settings
# http://editorconfig.org/

# use the top most editor config file
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
end_of_line = lf

[*.clj]
indent_size = 2
max_line_length = 120

[*.{css,scss,sass}]
indent_size = 2

[*.{md,markdown,mustache}]
indent_size = 4

[*.{html,liquid}]
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_size = 2

[*.json]
indent_size = 2
