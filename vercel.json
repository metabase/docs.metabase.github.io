{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/latest",
      "permanent": false
    },
    {
      "source": "/docs/w9",
      "destination": "https://www.metabase.com/files/2024_W9_signed.pdf",
      "statusCode": 301
    },
    {
      "source": "/docs/TRC",
      "destination": "https://www.metabase.com/files/TRC_2026.pdf",
      "statusCode": 301
    },
    {
      "source": "/docs",
      "destination": "/docs/latest",
      "statusCode": 301
    },
    {
      "source": "/docs/api",
      "destination": "/docs/latest/api",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/faq/general/does-metabase-have-access-to-my-companys-data",
      "destination": "/docs/latest/installation-and-operation/information-collection",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/faq/setup/which-databases-does-metabase-support",
      "destination": "/docs/latest/databases/connecting",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/faq/start",
      "destination": "/docs/latest",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/faq/using-metabase/how-do-i-reset-my-password",
      "destination": "/docs/latest/people-and-groups/account-settings",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/getting-started",
      "destination": "/learn/metabase-basics/getting-started/ask-a-question",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/paid-features",
      "destination": "/paid-features",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/paid-features/overview",
      "destination": "/paid-features",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/permissions/no-self-service-deprecated",
      "destination": "/docs/latest/permissions/no-self-service-deprecation",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/releases",
      "destination": "https://github.com/metabase/metabase/releases",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/users-guide/01-what-is-metabase",
      "destination": "/learn/metabase-basics/overview/tour-of-metabase",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/users-guide/02-database-basics",
      "destination": "/learn/grow-your-data-skills/data-fundamentals/database-basics",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/users-guide/custom-questions",
      "destination": "/docs/latest/questions/introduction",
      "statusCode": 301
    },
    {
      "source": "/docs/latest/cloud/how-billing-works",
      "destination": "https://www.metabase.com/how-billing-works",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
