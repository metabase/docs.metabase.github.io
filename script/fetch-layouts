#!/bin/sh
# usage: script/fetch-layouts
#
# Downloads the shared website layout export and unpacks it into the paths
# Jekyll expects in this repository.

set -eu

layout_export_url="${LAYOUT_EXPORT_URL:-http://localhost:8080/metabase-layouts.tar.gz}"
tmp_dir="${TMPDIR:-/tmp}/metabase-layouts.$$"
archive_path="${tmp_dir}/metabase-layouts.tar.gz"

replace_paths="
_data
_includes
_layouts
_sass
css
images
js
redirects
"

mkdir -p "${tmp_dir}"
trap 'rm -rf "${tmp_dir}"' EXIT

echo "Fetching shared layouts from ${layout_export_url}"
curl -fsSL "${layout_export_url}" -o "${archive_path}"

for path in ${replace_paths}; do
  rm -rf "${path}"
done

# _plugins can contain docs-specific plugins, so extract over it instead of
# replacing the directory wholesale.
tar -xzf "${archive_path}"

echo "Shared layouts installed."
