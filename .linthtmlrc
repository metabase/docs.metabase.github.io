{
	"maxerr": false,
	"text-ignore-regex": false,
	"raw-ignore-regex": false,
	"attr-name-ignore-regex": false,
	"id-class-ignore-regex": false,
	"line-max-len-ignore-regex": false,
	"extends": "@linthtml/linthtml-config-recommended",
	"rules": {
		"attr-bans": ["warning", [
			"align",
			"background",
			"bgcolor",
			"border",
			"frameborder",
			"longdesc",
			"marginwidth",
			"marginheight",
			"scrolling",
			"style",
			"width"
		]],
		"attr-quote-style": ["warning", "double"],
		"class-style": ["warning", "none"],
		"doctype-first": false,
		"id-style": ["warning", "none"],
    	"line-end-style": [
			true,
			"lf"
    	],
		"line-max-len": false,
		"tag-bans": ["warning",
		[
			"acronym",
			"applet",
			"basefont",
			"big",
			"center",
			"dir",
			"font",
			"frame",
			"frameset",
			"isindex",
			"noframes",
			"s",
			"strike",
			"tt",
			"u",
			"b"
		]],
		"title-max-len": false
	},
	"ignoreFiles": [
		"node_modules",
		"example_dbs/**/*",
		"script/**/*",
		"spec/**/*",
		"_docs/**/*.html",
		"_site/**/*.html"
	]
}