{% for post in site.posts %}
  {% if post.sitemap != false %}
    {% assign canonical = post.canonical | default: "" %}
    {% unless canonical contains "http" %}
      <url>
        <loc>https://www.metabase.com{{ post.url | split: "index.html" }}</loc>
        {% if post.last_updated_at %}
        <lastmod>{{ post.last_updated_at | date: "%FT%T%:z" }}</lastmod>
        {% else %}
        <lastmod>{{ post.date | date: "%FT%T%:z" }}</lastmod>
        {% endif %}
      </url>
    {% endunless %}
  {% endif %}
{% endfor %}
