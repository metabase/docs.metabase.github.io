<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

{% for article in site.case_studies %}
  {% if article.sitemap != false %}
    {% assign canonical = article.canonical | default: "" %}
    {% unless canonical contains "http" %}
      <url>
        <loc>https://www.metabase.com{{ article.url | replace: "/index", "/" }}</loc>
      </url>
    {% endunless %}
  {% endif %}
{% endfor %}
